+/* Caller holds mode_mutex; update software state only after the IRQ API succeeds. */
+static int fts_irq_wake_set(struct fts_ts_info *info, bool enable)
+{
+	int ret;
+
+	if (info->irq_wake_enabled == enable)
+		return 0;
+	ret = enable ? enable_irq_wake(info->client->irq) :
+		disable_irq_wake(info->client->irq);
+	if (ret) {
+		pr_err("fts: IRQ wake %s failed: %d\n", enable ? "enable" : "disable", ret);
+		return ret;
+	}
+	WRITE_ONCE(info->irq_wake_enabled, enable);
+	return 0;
+}
