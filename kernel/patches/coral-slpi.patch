+static DEFINE_MUTEX(fastrpc_sdsp_heap_lock);
+static struct {
+	phys_addr_t base;
+	size_t size;
+	struct qcom_scm_vmperm vmperms[FASTRPC_MAX_VMIDS];
+	int vmcount;
+	int result;
+	bool attempted;
+} fastrpc_sdsp_heap;
+
+static int fastrpc_share_sdsp_heap(struct fastrpc_channel_ctx *cctx,
+				 struct device *dev, const struct resource *res)
+{
+	u64 src_perms = BIT(QCOM_SCM_VMID_HLOS);
+	int err;
+
+	if (cctx->vmcount <= 0 || cctx->vmcount > FASTRPC_MAX_VMIDS ||
+	    !resource_size(res))
+		return -EINVAL;
+
+	mutex_lock(&fastrpc_sdsp_heap_lock);
+	if (fastrpc_sdsp_heap.attempted) {
+		if (fastrpc_sdsp_heap.base != res->start ||
+		    fastrpc_sdsp_heap.size != resource_size(res) ||
+		    fastrpc_sdsp_heap.vmcount != cctx->vmcount ||
+		    memcmp(fastrpc_sdsp_heap.vmperms, cctx->vmperms,
+			   cctx->vmcount * sizeof(*cctx->vmperms))) {
+			dev_err(dev, "SDSP heap metadata changed; reboot required\n");
+			err = -EINVAL;
+		} else {
+			err = fastrpc_sdsp_heap.result;
+		}
+		goto out;
+	}
+
+	fastrpc_sdsp_heap.base = res->start;
+	fastrpc_sdsp_heap.size = resource_size(res);
+	fastrpc_sdsp_heap.vmcount = cctx->vmcount;
+	memcpy(fastrpc_sdsp_heap.vmperms, cctx->vmperms,
+	       cctx->vmcount * sizeof(*cctx->vmperms));
+	fastrpc_sdsp_heap.attempted = true;
+	/*
+	 * Stock SM8150 shares this pool for the whole boot, including SSR.
+	 * ponytail: pin until reboot; unload needs a persistent pool owner and
+	 * a proven reclaim protocol, including failed SCM assignment recovery.
+	 */
+	__module_get(THIS_MODULE);
+	err = qcom_scm_assign_mem(res->start, resource_size(res), &src_perms,
+				  cctx->vmperms, cctx->vmcount);
+	fastrpc_sdsp_heap.result = err;
+	if (err)
+		dev_err(dev, "Failed to share SDSP heap: %d; quarantined until reboot\n", err);
+	else
+		dev_info(dev, "SDSP heap shared for boot lifetime; module pinned\n");
+out:
+	mutex_unlock(&fastrpc_sdsp_heap_lock);
+	return err;
+}
