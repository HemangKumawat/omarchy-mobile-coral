+/* SM8150 SDSP interconnect workaround: real IOVAs in the context-bank window. */
+static bool fastrpc_valid_sdsp_dma(struct fastrpc_user *fl, u64 addr, u64 size)
+{
+	u64 start, end;
+
+	if (!fl->sctx)
+		return false;
+	start = ((u64)fl->sctx->sid << 32) + 0x80000000ULL;
+	end = start + 0x78000000ULL;
+
+	return addr >= start && addr < end && size <= end - addr;
+}
