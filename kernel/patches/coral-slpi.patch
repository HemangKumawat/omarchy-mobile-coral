# Pixel 4 XL SLPI DT on accepted kernel 65adbcf4ac89754d0f1b52eff47bc6ab6af69947.
# SDSP heap adapted from official pmOS andrew/6.16-sensors
# 2a070aeb7730f28ca2b99ba29f82633098469aba (DT SPDX BSD-3-Clause).
# MMIO corroborated by Google kernel/msm 82a738b32e3f715728b846f8908083286287cb06
# arch/arm64/boot/dts/qcom/sm8150.dtsi: pil_ssc at 0x05c00000, size 0x4000.
# FastRPC 34-bit SDSP window matches GPL-2.0 Google drivers/char/adsprpc.c
# at that same pinned commit; original DMA handles are kept for free/mmap.
# Normal-boot pool owners are HLOS/SSC_Q6/ADSP_Q6 from pinned stock adsprpc.c.
# One pool assignment persists across SSR, matching stock platform-device lifetime.
# The module stays pinned until reboot, including a quarantined assignment failure;
# no speculative revoke or unsafe module-exit reclaim is attempted.
# Sleepstate publication follows Richard Acayan v2 07/11, 2026-10-03:
# https://www.mail-archive.com/linux-remoteproc%40vger.kernel.org/msg00850.html
# and is corroborated by stock sm8150-smp2p.dtsi at the Google commit above.
# No Google firmware. Runtime links must be from read-only stock partitions.
diff --git a/arch/arm64/boot/dts/qcom/sm8150-google-coral.dts b/arch/arm64/boot/dts/qcom/sm8150-google-coral.dts
index 36f4670bc..fd213ff4e 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-google-coral.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-google-coral.dts
@@ -92,8 +92,50 @@ &remoteproc_mpss {
 	firmware-name = "qcom/sm8150/google/coral/modem.mdt";
 };
 
+/* pmOS andrew/6.16-sensors 2a070aeb: SDSP remote heap below 4 GiB. */
+/ {
+	/* Stock DSPS entry; also prevents the upstream sar.cc:27 CHRE fatal. */
+	smp2p-slpi {
+		sleepstate {
+			qcom,entry-name = "sleepstate";
+			#qcom,smem-state-cells = <1>;
+		};
+	};
+
+	reserved-memory {
+		coral_fastrpc_mem: fastrpc {
+			compatible = "shared-dma-pool";
+			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0x1000000>;
+			reusable;
+		};
+	};
+};
+
 &remoteproc_slpi {
+	status = "okay";
 	firmware-name = "qcom/sm8150/google/coral/slpi.mdt";
+
+	glink-edge {
+		fastrpc {
+			/* Stock normal-boot pool owners; MSS_MSA is restore-only. */
+			qcom,vmids = <QCOM_SCM_VMID_HLOS QCOM_SCM_VMID_SSC_Q6
+				      QCOM_SCM_VMID_ADSP_Q6>;
+			memory-region = <&coral_fastrpc_mem>;
+
+			/* Stock sm8150 SDSP context banks are coherent. */
+			compute-cb@1 {
+				dma-coherent;
+			};
+			compute-cb@2 {
+				dma-coherent;
+			};
+			compute-cb@3 {
+				dma-coherent;
+			};
+		};
+	};
 };
 
 
