+/* SMB5: state0 is inhibit and state6 is pause; neither means charging. */
+static int smb_charge_state(struct smb_chip *chip, u32 stat)
+{
+	if (chip->gen == SMB5 && (stat == 0 || stat == 6))
+		return POWER_SUPPLY_STATUS_NOT_CHARGING;
+
+	switch (stat) {
+	case TRICKLE_CHARGE:
+	case PRE_CHARGE:
+	case FAST_CHARGE:
+	case FULLON_CHARGE:
+	case TAPER_CHARGE:
+		return POWER_SUPPLY_STATUS_CHARGING;
+	case DISABLE_CHARGE:
+		return POWER_SUPPLY_STATUS_NOT_CHARGING;
+	case TERMINATE_CHARGE:
+	case INHIBIT_CHARGE:
+		return POWER_SUPPLY_STATUS_FULL;
+	default:
+		return POWER_SUPPLY_STATUS_UNKNOWN;
+	}
 }
 
