+/* SMB5 encoding follows Google's pm8150b params; SMB2 retains its own scale. */
+static int smb_set_float_voltage(struct smb_chip *chip, int uv)
+{
+	int minimum = chip->gen == SMB5 ? 3600000 : 3487500;
+	int step = chip->gen == SMB5 ? 10000 : 7500;
+	int offset = chip->gen == SMB5 ? 0 : 1;
+	unsigned int raw;
+
+	if (!chip->batt_info)
+		return -EAGAIN;
+	if (uv < minimum || uv > chip->batt_info->voltage_max_design_uv ||
+	    (chip->gen == SMB5 && uv > 4790000))
+		return -EINVAL;
+	raw = (uv - minimum) / step + offset;
+	if (raw > FLOAT_VOLTAGE_SETTING_MASK)
+		return -EINVAL;
+
+	return regmap_update_bits(chip->regmap, chip->base + FLOAT_VOLTAGE_CFG,
+				  FLOAT_VOLTAGE_SETTING_MASK, raw);
+}
+
+static int smb_set_fast_charge_current(struct smb_chip *chip, int ua)
+{
+	if (!chip->batt_info)
+		return -EAGAIN;
+	if (ua < 0 || ua > chip->batt_info->constant_charge_current_max_ua ||
+	    ua / CHARGE_CURRENT_STEP(chip) > FAST_CHARGE_CURRENT_SETTING_MASK)
+		return -EINVAL;
+
+	return regmap_update_bits(chip->regmap, chip->base + FAST_CHARGE_CURRENT_CFG,
+				  FAST_CHARGE_CURRENT_SETTING_MASK,
+				  ua / CHARGE_CURRENT_STEP(chip));
+}
