diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3hc2.c b/drivers/gpu/drm/panel/panel-samsung-s6e3hc2.c
new file mode 100644
index 000000000..6ada1a6a6
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3hc2.c
@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Generated with linux-mdss-dsi-panel-driver-generator (28c4df2) from the
+// Google coral (Pixel 4 XL) stock dtbo, board-id 0x51e05, node
+// qcom,mdss_dsi_s6e3hc2 ("s6e3hc2 amoled 6.2 cmd mode panel").
+// Supplies and voltages from dsi_panel_pwr_supply_floral in the same dtbo.
+// ponytail: 60 Hz timing@0 only; timing@1 (90 Hz) differs only in framerate.
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/mod_devicetable.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct s6e3hc2 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+};
+
+/* stock: vddio 1.84 V, vci 3.0 V (qcom,panel-supply-entry@0/1) */
+static const struct regulator_bulk_data s6e3hc2_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "vci" },
+};
+
+static const int s6e3hc2_supply_uV[] = { 1840000, 3000000 };
+
+static inline struct s6e3hc2 *to_s6e3hc2(struct drm_panel *panel)
+{
+	return container_of_const(panel, struct s6e3hc2, panel);
+}
+
+static void s6e3hc2_reset(struct s6e3hc2 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+}
+
+static int s6e3hc2_on(struct s6e3hc2 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_compression_mode_multi(&dsi_ctx, true);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x20);
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf1, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x3c, 0xb5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb5, 0x9c, 0xd5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x86, 0xeb);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xeb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x68, 0x21);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x69, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf1, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3hc2_off(struct s6e3hc2 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_usleep_range(&dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3hc2_prepare(struct drm_panel *panel)
+{
+	struct s6e3hc2 *ctx = to_s6e3hc2(panel);
+	struct device *dev = &ctx->dsi->dev;
+	struct drm_dsc_picture_parameter_set pps;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s6e3hc2_supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	s6e3hc2_reset(ctx);
+
+	ret = s6e3hc2_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(s6e3hc2_supplies), ctx->supplies);
+		return ret;
+	}
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+
+	ret = mipi_dsi_picture_parameter_set(ctx->dsi, &pps);
+	if (ret < 0) {
+		dev_err(panel->dev, "failed to transmit PPS: %d\n", ret);
+		return ret;
+	}
+
+	ret = mipi_dsi_compression_mode(ctx->dsi, true);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable compression mode: %d\n", ret);
+		return ret;
+	}
+
+	msleep(28); /* TODO: Is this panel-dependent? */
+
+	return 0;
+}
+
+static int s6e3hc2_enable(struct drm_panel *panel)
+{
+	struct s6e3hc2 *ctx = to_s6e3hc2(panel);
+	u8 mode = 0;
+	int ret;
+
+	ret = mipi_dsi_dcs_get_power_mode(ctx->dsi, &mode);
+	if (ret < 0) {
+		dev_err(panel->dev, "DCS power mode read failed: %d\n", ret);
+		return ret;
+	}
+	dev_info(panel->dev, "coral DCS power mode: 0x%02x\n", mode);
+	return 0;
+}
+
+static int s6e3hc2_unprepare(struct drm_panel *panel)
+{
+	struct s6e3hc2 *ctx = to_s6e3hc2(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = s6e3hc2_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(s6e3hc2_supplies), ctx->supplies);
+
+	return 0;
+}
+
+static const struct drm_display_mode s6e3hc2_mode = {
+	.clock = (1440 + 56 + 16 + 28) * (3040 + 12 + 4 + 16) * 60 / 1000,
+	.hdisplay = 1440,
+	.hsync_start = 1440 + 56,
+	.hsync_end = 1440 + 56 + 16,
+	.htotal = 1440 + 56 + 16 + 28,
+	.vdisplay = 3040,
+	.vsync_start = 3040 + 12,
+	.vsync_end = 3040 + 12 + 4,
+	.vtotal = 3040 + 12 + 4 + 16,
+	.width_mm = 68,
+	.height_mm = 143,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int s6e3hc2_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &s6e3hc2_mode);
+}
+
+static const struct drm_panel_funcs s6e3hc2_panel_funcs = {
+	.prepare = s6e3hc2_prepare,
+	.enable = s6e3hc2_enable,
+	.unprepare = s6e3hc2_unprepare,
+	.get_modes = s6e3hc2_get_modes,
+};
+
+static int s6e3hc2_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+// TODO: Check if /sys/class/backlight/.../actual_brightness actually returns
+// correct values. If not, remove this function.
+static int s6e3hc2_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness;
+}
+
+static const struct backlight_ops s6e3hc2_bl_ops = {
+	.update_status = s6e3hc2_bl_update_status,
+	.get_brightness = s6e3hc2_bl_get_brightness,
+};
+
+static struct backlight_device *
+s6e3hc2_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 1023,
+		.max_brightness = 1023,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &s6e3hc2_bl_ops, &props);
+}
+
+static int s6e3hc2_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e3hc2 *ctx;
+	int i, ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e3hc2, panel,
+				   &s6e3hc2_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(s6e3hc2_supplies),
+					    s6e3hc2_supplies, &ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(s6e3hc2_supplies); i++) {
+		ret = regulator_set_voltage(ctx->supplies[i].consumer,
+					    s6e3hc2_supply_uV[i],
+					    s6e3hc2_supply_uV[i]);
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "Failed to set %s voltage\n",
+					     ctx->supplies[i].supply);
+	}
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = s6e3hc2_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	/* ponytail: 6.17 has no devm_drm_panel_add; manual add/remove */
+	drm_panel_add(&ctx->panel);
+
+	/* This panel only supports DSC; unconditionally enable it */
+	dsi->dsc = &ctx->dsc;
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+
+	/* TODO: Pass slice_per_pkt = 1 */
+	ctx->dsc.slice_height = 40;
+	ctx->dsc.slice_width = 720;
+	/*
+	 * TODO: hdisplay should be read from the selected mode once
+	 * it is passed back to drm_panel (in prepare?)
+	 */
+	WARN_ON(1440 % ctx->dsc.slice_width);
+	ctx->dsc.slice_count = 1440 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void s6e3hc2_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e3hc2 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e3hc2_of_match[] = {
+	{ .compatible = "samsung,s6e3hc2" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s6e3hc2_of_match);
+
+static struct mipi_dsi_driver s6e3hc2_driver = {
+	.probe = s6e3hc2_probe,
+	.remove = s6e3hc2_remove,
+	.driver = {
+		.name = "panel-s6e3hc2",
+		.of_match_table = s6e3hc2_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e3hc2_driver);
+
+MODULE_DESCRIPTION("DRM driver for Samsung S6E3HC2 AMOLED cmd mode panel (Pixel 4 XL)");
+MODULE_LICENSE("GPL");
