+MODULE_DEVICE_TABLE(of, imx481_of_match);
+
+static struct i2c_driver imx481_driver = {
+	.probe = imx481_probe,
+	.remove = imx481_remove,
+	.driver = {
+		.name = "imx481",
+		.pm = &imx481_pm_ops,
+		.of_match_table = imx481_of_match,
+	},
+};
+
+module_i2c_driver(imx481_driver);
