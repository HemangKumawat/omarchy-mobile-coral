+/**
+ * imx481_power_on() - Sensor power on sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx481_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx481 *imx481 = to_imx481(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx481->auxiliary), imx481->auxiliary);
+	if (ret)
+		return ret;
+
+	ret = regulator_set_voltage(imx481->vana, IMX481_VANA_MIN_UV,
+				    IMX481_VANA_MAX_UV);
+	if (ret)
+		goto error_auxiliary;
+
+	ret = regulator_enable(imx481->vana);
+	if (ret)
+		goto error_vana_voltage;
+
+	gpiod_set_value_cansleep(imx481->vana_enable_gpio, 1);
+	usleep_range(1000, 2000);
+
+	ret = regulator_set_load(imx481->vdig, IMX481_VDIG_LOAD_UA);
+	if (ret)
+		goto error_vana;
+
+	ret = regulator_enable(imx481->vdig);
+	if (ret)
+		goto error_vdig_load;
+	usleep_range(1000, 2000);
+
+	ret = regulator_enable(imx481->vio);
+	if (ret)
+		goto error_vdig;
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(imx481->inclk);
+	if (ret) {
+		dev_err(imx481->dev, "failed to enable input clock\n");
+		goto error_vio;
+	}
+
+	usleep_range(1000, 1200);
+	gpiod_set_value_cansleep(imx481->reset_gpio, 0);
+	usleep_range(1000, 2000);
+
+	return 0;
+
+error_vio:
+	regulator_disable(imx481->vio);
+error_vdig:
+	regulator_disable(imx481->vdig);
+error_vdig_load:
+	regulator_set_load(imx481->vdig, 0);
+error_vana:
+	gpiod_set_value_cansleep(imx481->vana_enable_gpio, 0);
+	regulator_disable(imx481->vana);
+error_vana_voltage:
+	regulator_set_voltage(imx481->vana, 0, IMX481_VANA_MAX_UV);
+error_auxiliary:
+	regulator_bulk_disable(ARRAY_SIZE(imx481->auxiliary), imx481->auxiliary);
+
+	return ret;
+}
+
+/**
+ * imx481_power_off() - Sensor power off sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx481_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx481 *imx481 = to_imx481(sd);
+
+	gpiod_set_value_cansleep(imx481->reset_gpio, 1);
+	clk_disable_unprepare(imx481->inclk);
+	regulator_disable(imx481->vio);
+	regulator_disable(imx481->vdig);
+	regulator_set_load(imx481->vdig, 0);
+	gpiod_set_value_cansleep(imx481->vana_enable_gpio, 0);
+	regulator_disable(imx481->vana);
+	regulator_set_voltage(imx481->vana, 0, IMX481_VANA_MAX_UV);
+	regulator_bulk_disable(ARRAY_SIZE(imx481->auxiliary), imx481->auxiliary);
+
+	return 0;
+}
