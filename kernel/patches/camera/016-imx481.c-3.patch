--- a/drivers/media/i2c/imx481.c
+++ b/drivers/media/i2c/imx481.c
@@ -798,3 +798,370 @@
 			goto done_endpoint_free;
 
 	ret = -EINVAL;
+
+done_endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
