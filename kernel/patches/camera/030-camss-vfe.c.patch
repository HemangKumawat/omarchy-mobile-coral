 	for (i = 0; i < vfe->nclocks; i++) {
 		struct camss_clock *clock = &vfe->clock[i];
 
+		/* Stock SM8150 CPAS floors active CAMNOC BW at 3 GB/s.
+		 * Its 32-byte bus needs 93.75 MHz; the next OPP is 150 MHz.
+		 */
+		if (vfe->camss->res->version == CAMSS_8150 &&
