--- a/drivers/media/i2c/imx520.c
+++ b/drivers/media/i2c/imx520.c
@@ -798,3 +798,368 @@
 	ret = -EINVAL;
 
 done_endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
