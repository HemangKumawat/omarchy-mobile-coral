+/**
+ * imx520_power_on() - Sensor power on sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx520 *imx520 = to_imx520(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx520->auxiliary), imx520->auxiliary);
+	if (ret)
+		return ret;
+
+	ret = regulator_set_voltage(imx520->vana, IMX520_VANA_MIN_UV,
+				    IMX520_VANA_MAX_UV);
+	if (ret)
+		goto error_auxiliary;
+
+	ret = regulator_enable(imx520->vana);
+	if (ret)
+		goto error_vana_voltage;
+
+	gpiod_set_value_cansleep(imx520->vana_enable_gpio, 1);
+	usleep_range(1000, 2000);
+
+	ret = regulator_set_load(imx520->vdig, IMX520_VDIG_LOAD_UA);
+	if (ret)
+		goto error_vana;
+
+	ret = regulator_enable(imx520->vdig);
+	if (ret)
+		goto error_vdig_load;
+	usleep_range(1000, 2000);
+
+	ret = regulator_enable(imx520->vio);
+	if (ret)
+		goto error_vdig;
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(imx520->inclk);
+	if (ret) {
+		dev_err(imx520->dev, "failed to enable input clock\n");
+		goto error_vio;
+	}
+
+	usleep_range(1000, 1200);
+	gpiod_set_value_cansleep(imx520->reset_gpio, 0);
+	usleep_range(1000, 2000);
+
+	return 0;
+
+error_vio:
+	regulator_disable(imx520->vio);
+error_vdig:
+	regulator_disable(imx520->vdig);
+error_vdig_load:
+	regulator_set_load(imx520->vdig, 0);
+error_vana:
+	gpiod_set_value_cansleep(imx520->vana_enable_gpio, 0);
+	regulator_disable(imx520->vana);
+error_vana_voltage:
+	regulator_set_voltage(imx520->vana, 0, IMX520_VANA_MAX_UV);
+error_auxiliary:
+	regulator_bulk_disable(ARRAY_SIZE(imx520->auxiliary), imx520->auxiliary);
+
+	return ret;
+}
+
+/**
+ * imx520_power_off() - Sensor power off sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx520 *imx520 = to_imx520(sd);
+
+	gpiod_set_value_cansleep(imx520->reset_gpio, 1);
+	clk_disable_unprepare(imx520->inclk);
+	regulator_disable(imx520->vio);
+	regulator_disable(imx520->vdig);
+	regulator_set_load(imx520->vdig, 0);
+	gpiod_set_value_cansleep(imx520->vana_enable_gpio, 0);
+	regulator_disable(imx520->vana);
+	regulator_set_voltage(imx520->vana, 0, IMX520_VANA_MAX_UV);
+	regulator_bulk_disable(ARRAY_SIZE(imx520->auxiliary), imx520->auxiliary);
+
+	return 0;
+}
+
+/**
+ * imx520_init_controls() - Initialize sensor subdevice controls
+ * @imx520: pointer to imx520 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_init_controls(struct imx520 *imx520)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx520->ctrl_handler;
+	const struct imx520_mode *mode = imx520->cur_mode;
+	struct v4l2_fwnode_device_properties props;
+	u32 lpfr;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 8);
+	if (ret)
+		return ret;
+
+	/* Serialize controls with sensor device */
+	ctrl_hdlr->lock = &imx520->mutex;
+
+	/* Initialize exposure and gain */
+	lpfr = mode->vblank + mode->height;
+	imx520->exp_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					     &imx520_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX520_EXPOSURE_MIN,
+					     lpfr - IMX520_EXPOSURE_OFFSET,
+					     IMX520_EXPOSURE_STEP,
+					     IMX520_EXPOSURE_DEFAULT);
+
+	imx520->again_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					       &imx520_ctrl_ops,
+					       V4L2_CID_ANALOGUE_GAIN,
+					       IMX520_AGAIN_MIN,
+					       IMX520_AGAIN_MAX,
+					       IMX520_AGAIN_STEP,
+					       IMX520_AGAIN_DEFAULT);
+
+	v4l2_ctrl_cluster(2, &imx520->exp_ctrl);
+
+	imx520->vblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx520_ctrl_ops,
+						V4L2_CID_VBLANK,
+						mode->vblank_min,
+						mode->vblank_max,
+						1, mode->vblank);
+
+	/* Read only controls */
+	imx520->pclk_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					      &imx520_ctrl_ops,
+					      V4L2_CID_PIXEL_RATE,
+					      mode->pclk, mode->pclk,
+					      1, mode->pclk);
+
+	imx520->link_freq_ctrl = v4l2_ctrl_new_int_menu(ctrl_hdlr,
+							&imx520_ctrl_ops,
+							V4L2_CID_LINK_FREQ,
+							ARRAY_SIZE(link_freq) -
+							1,
+							mode->link_freq_idx,
+							link_freq);
+	if (imx520->link_freq_ctrl)
+		imx520->link_freq_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx520->hblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx520_ctrl_ops,
+						V4L2_CID_HBLANK,
+						IMX520_REG_MIN,
+						IMX520_REG_MAX,
+						1, mode->hblank);
+	if (imx520->hblank_ctrl)
+		imx520->hblank_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ret = v4l2_fwnode_device_parse(imx520->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &imx520_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		dev_err(imx520->dev, "control init failed: %d\n",
+			ret);
+		goto error_free_hdlr;
+	}
+
+	imx520->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
