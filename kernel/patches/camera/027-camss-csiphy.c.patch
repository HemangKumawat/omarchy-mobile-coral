 /*
+ * msm_csiphy_init_combo - Add a logical route sharing SM8150 PHY3 resources
+ * @csiphy: CSIPHY device
+ *
+ * Return 0 on success or a negative error code otherwise
+ */
+int msm_csiphy_init_combo(struct csiphy_device *csiphy)
+{
+	struct csiphy_device *peer;
+
+	if (csiphy->camss->res->version != CAMSS_8150 || csiphy->id != 3)
+		return -EOPNOTSUPP;
+	if (csiphy->combo_peer)
+		return -EINVAL;
+	peer = devm_kzalloc(csiphy->camss->dev, sizeof(*peer), GFP_KERNEL);
+	if (!peer)
+		return -ENOMEM;
+
+	peer->camss = csiphy->camss;
+	peer->id = csiphy->id;
+	peer->shared_phy = csiphy;
+	peer->base = csiphy->base;
+	peer->base_clk_mux = csiphy->base_clk_mux;
+	peer->irq = csiphy->irq;
+	peer->clock = csiphy->clock;
+	peer->rate_set = csiphy->rate_set;
+	peer->nclocks = csiphy->nclocks;
+	peer->supplies = csiphy->supplies;
+	peer->num_supplies = csiphy->num_supplies;
+	peer->res = csiphy->res;
+	peer->regs = csiphy->regs;
+	peer->cfg.combo_mode = 1;
+	csiphy->cfg.combo_mode = 1;
+	csiphy->combo_peer = peer;
+	return 0;
+}
