+static int csiphy_set_power(struct v4l2_subdev *sd, int on)
+{
+	struct csiphy_device *csiphy = v4l2_get_subdevdata(sd);
+	struct csiphy_device *owner = csiphy->shared_phy ?: csiphy;
+	struct csiphy_lanes_cfg *lanes;
+	s64 link_freq;
+	u8 bpp;
+	int ret = 0;
+
+	if (!csiphy->cfg.combo_mode)
+		return csiphy_set_power_hw(sd, on);
+
+	mutex_lock(&owner->combo_lock);
+	if (!!on == csiphy->powered)
+		goto out;
+	if (!on) {
+		if (csiphy->streaming) {
+			ret = -EBUSY;
+			goto out;
+		}
+		if (!--owner->power_users)
+			ret = csiphy_set_power_hw(sd, 0);
+		csiphy->powered = false;
+		goto out;
+	}
+	if (!csiphy->cfg.csi2) {
+		ret = -ENOLINK;
+		goto out;
+	}
+	lanes = &csiphy->cfg.csi2->lane_cfg;
+	bpp = csiphy_get_bpp(csiphy->res->formats->formats,
+			     csiphy->res->formats->nformats,
+			     csiphy->fmt[MSM_CSIPHY_PAD_SINK].code);
+	link_freq = camss_get_link_freq(&sd->entity, bpp, lanes->num_data);
+	if (link_freq <= 0) {
+		ret = -EINVAL;
+		goto out;
+	}
+	/* Do not change a shared timer clock underneath the running peer. */
+	if (owner->power_users && link_freq != owner->combo_link_freq) {
+		dev_err(csiphy->camss->dev, "PHY3 combo requires equal link frequencies\n");
+		ret = -EINVAL;
+		goto out;
+	}
+	if (!owner->power_users) {
+		ret = csiphy_set_power_hw(sd, 1);
+		if (ret)
+			goto out;
+		owner->combo_link_freq = link_freq;
+		owner->timer_clk_rate = csiphy->timer_clk_rate;
+		owner->combo_peer->timer_clk_rate = csiphy->timer_clk_rate;
+	}
+	owner->power_users++;
+	csiphy->powered = true;
+out:
+	mutex_unlock(&owner->combo_lock);
+	return ret;
 }
 
