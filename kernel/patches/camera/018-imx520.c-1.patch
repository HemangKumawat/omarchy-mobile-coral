+#include <linux/unaligned.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+/* Streaming Mode */
+#define IMX520_REG_MODE_SELECT	0x0100
+#define IMX520_MODE_STANDBY	0x00
+#define IMX520_MODE_STREAMING	0x01
+
+/* Lines per frame */
+#define IMX520_REG_LPFR		0x0340
+
+/* Chip ID */
+#define IMX520_REG_ID		0x0016
+#define IMX520_ID		0x0520
+
+/* Exposure control */
+#define IMX520_REG_EXPOSURE_CIT	0x0202
+#define IMX520_EXPOSURE_MIN	1
+#define IMX520_EXPOSURE_OFFSET	10
+#define IMX520_EXPOSURE_STEP	1
+#define IMX520_EXPOSURE_DEFAULT	0x0a0c
+
+/* Analog gain control */
+#define IMX520_REG_AGAIN	0x0204
+#define IMX520_AGAIN_MIN	0
+#define IMX520_AGAIN_MAX	960
+#define IMX520_AGAIN_STEP	1
+#define IMX520_AGAIN_DEFAULT	0
+
+/* Group hold register */
+#define IMX520_REG_HOLD		0x0104
+
+/* Input clock rate */
+#define IMX520_INCLK_RATE	24000000
+
+#define IMX520_VANA_MIN_UV	2800000
+#define IMX520_VANA_MAX_UV	2800000
+#define IMX520_VDIG_LOAD_UA	1100000
+
+/* CSI2 HW configuration */
+#define IMX520_LINK_FREQ	675000000
+#define IMX520_NUM_DATA_LANES	2
+
+#define IMX520_REG_MIN		0x00
+#define IMX520_REG_MAX		0xffff
+
+/**
+ * struct imx520_reg - imx520 sensor register
+ * @address: Register address
+ * @val: Register value
+ */
+struct imx520_reg {
+	u16 address;
+	u8 val;
+};
+
+/**
+ * struct imx520_reg_list - imx520 sensor register list
+ * @num_of_regs: Number of registers in the list
+ * @regs: Pointer to register list
+ */
+struct imx520_reg_list {
+	u32 num_of_regs;
+	const struct imx520_reg *regs;
+};
+
+/**
+ * struct imx520_mode - imx520 sensor mode structure
+ * @width: Frame width
+ * @height: Frame height
+ * @code: Format code
+ * @hblank: Horizontal blanking in lines
+ * @vblank: Vertical blanking in lines
+ * @vblank_min: Minimum vertical blanking in lines
+ * @vblank_max: Maximum vertical blanking in lines
+ * @pclk: Sensor pixel clock
+ * @link_freq_idx: Link frequency index
+ * @reg_list: Register list for sensor mode
+ */
+struct imx520_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	u32 hblank;
+	u32 vblank;
+	u32 vblank_min;
+	u32 vblank_max;
+	u64 pclk;
+	u32 link_freq_idx;
+	struct imx520_reg_list reg_list;
+};
+
+/**
+ * struct imx520 - imx520 sensor device structure
+ * @dev: Pointer to generic device
+ * @client: Pointer to i2c client
+ * @sd: V4L2 sub-device
+ * @pad: Media pad. Only one pad supported
+ * @reset_gpio: Sensor reset gpio
+ * @vana_enable_gpio: Board analogue-rail gate gpio
+ * @inclk: Sensor input clock
+ * @vana: Analogue regulator
+ * @vdig: Digital regulator
+ * @vio: I/O regulator
+ * @ctrl_handler: V4L2 control handler
+ * @link_freq_ctrl: Pointer to link frequency control
+ * @pclk_ctrl: Pointer to pixel clock control
+ * @hblank_ctrl: Pointer to horizontal blanking control
+ * @vblank_ctrl: Pointer to vertical blanking control
+ * @exp_ctrl: Pointer to exposure control
+ * @again_ctrl: Pointer to analog gain control
+ * @vblank: Vertical blanking in lines
+ * @cur_mode: Pointer to current selected sensor mode
+ * @mutex: Mutex for serializing sensor controls
+ */
+struct imx520 {
+	struct device *dev;
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *vana_enable_gpio;
+	struct clk *inclk;
+	struct regulator *vana;
+	struct regulator *vdig;
+	struct regulator *vio;
+	struct regulator_bulk_data auxiliary[2];
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq_ctrl;
+	struct v4l2_ctrl *pclk_ctrl;
+	struct v4l2_ctrl *hblank_ctrl;
+	struct v4l2_ctrl *vblank_ctrl;
+	struct {
+		struct v4l2_ctrl *exp_ctrl;
+		struct v4l2_ctrl *again_ctrl;
+	};
+	u32 vblank;
+	const struct imx520_mode *cur_mode;
+	/* Serializes controls and streaming state. */
+	struct mutex mutex;
+};
+
+static const s64 link_freq[] = {
+	IMX520_LINK_FREQ,
+};
+
+#include "imx520-coral-tables.h"
+
+/**
+ * to_imx520() - imx520 V4L2 sub-device to imx520 device.
+ * @subdev: pointer to imx520 V4L2 sub-device
+ *
+ * Return: pointer to imx520 device
+ */
+static inline struct imx520 *to_imx520(struct v4l2_subdev *subdev)
+{
+	return container_of(subdev, struct imx520, sd);
+}
+
+/**
+ * imx520_read_reg() - Read registers.
+ * @imx520: pointer to imx520 device
+ * @reg: register address
+ * @len: length of bytes to read. Max supported bytes is 4
+ * @val: pointer to register value to be filled.
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_read_reg(struct imx520 *imx520, u16 reg, u32 len, u32 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx520->sd);
+	struct i2c_msg msgs[2] = {0};
+	u8 addr_buf[2] = {0};
+	u8 data_buf[4] = {0};
+	int ret;
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, addr_buf);
+
+	/* Write register address */
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = ARRAY_SIZE(addr_buf);
+	msgs[0].buf = addr_buf;
+
+	/* Read data from register */
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_buf[4 - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = get_unaligned_be32(data_buf);
+
+	return 0;
+}
+
+/**
+ * imx520_write_reg() - Write register
+ * @imx520: pointer to imx520 device
+ * @reg: register address
+ * @len: length of bytes. Max supported bytes is 4
+ * @val: register value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_write_reg(struct imx520 *imx520, u16 reg, u32 len, u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx520->sd);
+	u8 buf[6] = {0};
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, buf);
+	put_unaligned_be32(val << (8 * (4 - len)), buf + 2);
+	if (i2c_master_send(client, buf, len + 2) != len + 2)
+		return -EIO;
+
+	return 0;
+}
+
+/**
+ * imx520_write_regs() - Write a list of registers
+ * @imx520: pointer to imx520 device
+ * @regs: list of registers to be written
+ * @len: length of registers array
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_write_regs(struct imx520 *imx520,
+			     const struct imx520_reg *regs, u32 len)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < len; i++) {
+		ret = imx520_write_reg(imx520, regs[i].address, 1, regs[i].val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * imx520_update_controls() - Update control ranges based on streaming mode
+ * @imx520: pointer to imx520 device
+ * @mode: pointer to imx520_mode sensor mode
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_update_controls(struct imx520 *imx520,
+				  const struct imx520_mode *mode)
+{
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx520->link_freq_ctrl, mode->link_freq_idx);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx520->hblank_ctrl, mode->hblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_modify_range(imx520->vblank_ctrl, mode->vblank_min,
+					mode->vblank_max, 1, mode->vblank);
+}
+
+/**
+ * imx520_update_exp_gain() - Set updated exposure and gain
+ * @imx520: pointer to imx520 device
+ * @exposure: updated exposure value
+ * @gain: updated analog gain value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_update_exp_gain(struct imx520 *imx520, u32 exposure, u32 gain)
+{
+	u32 lpfr;
+	int ret;
+
+	lpfr = imx520->vblank + imx520->cur_mode->height;
+
+	dev_dbg(imx520->dev, "Set exp %u, analog gain %u, lpfr %u\n",
+		exposure, gain, lpfr);
+
+	ret = imx520_write_reg(imx520, IMX520_REG_HOLD, 1, 1);
+	if (ret)
+		return ret;
+
+	ret = imx520_write_reg(imx520, IMX520_REG_LPFR, 2, lpfr);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx520_write_reg(imx520, IMX520_REG_EXPOSURE_CIT, 2, exposure);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx520_write_reg(imx520, IMX520_REG_AGAIN, 2, gain);
+
+error_release_group_hold:
+	imx520_write_reg(imx520, IMX520_REG_HOLD, 1, 0);
+
+	return ret;
+}
+
+/**
+ * imx520_set_ctrl() - Set subdevice control
+ * @ctrl: pointer to v4l2_ctrl structure
+ *
+ * Supported controls:
+ * - V4L2_CID_VBLANK
+ * - cluster controls:
+ *   - V4L2_CID_ANALOGUE_GAIN
+ *   - V4L2_CID_EXPOSURE
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx520 *imx520 =
+		container_of(ctrl->handler, struct imx520, ctrl_handler);
+	u32 analog_gain;
+	u32 exposure;
+	int ret;
+
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		imx520->vblank = imx520->vblank_ctrl->val;
+
+		dev_dbg(imx520->dev, "Received vblank %u, new lpfr %u\n",
+			imx520->vblank,
+			imx520->vblank + imx520->cur_mode->height);
+
+		ret = __v4l2_ctrl_modify_range(imx520->exp_ctrl,
+					       IMX520_EXPOSURE_MIN,
+					       imx520->vblank +
+					       imx520->cur_mode->height -
+					       IMX520_EXPOSURE_OFFSET,
+					       1, IMX520_EXPOSURE_DEFAULT);
+		break;
+	case V4L2_CID_EXPOSURE:
+		/* Set controls only if sensor is in power on state */
+		if (!pm_runtime_get_if_in_use(imx520->dev))
+			return 0;
+
+		exposure = ctrl->val;
+		analog_gain = imx520->again_ctrl->val;
+
+		dev_dbg(imx520->dev, "Received exp %u, analog gain %u\n",
+			exposure, analog_gain);
+
+		ret = imx520_update_exp_gain(imx520, exposure, analog_gain);
+
+		pm_runtime_put(imx520->dev);
+
+		break;
+	default:
+		dev_err(imx520->dev, "Invalid control %d\n", ctrl->id);
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
+
+/* V4l2 subdevice control ops*/
+static const struct v4l2_ctrl_ops imx520_ctrl_ops = {
+	.s_ctrl = imx520_set_ctrl,
+};
+
+/**
+ * imx520_enum_mbus_code() - Enumerate V4L2 sub-device mbus codes
+ * @sd: pointer to imx520 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @code: V4L2 sub-device code enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
