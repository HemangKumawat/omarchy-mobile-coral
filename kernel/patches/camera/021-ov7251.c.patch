+/* Configure frame sync without driving the module's optical strobe pins. */
+static int ov7251_configure_fsin(struct ov7251 *ov7251)
+{
+	struct reg_value regs[] = {
+		{ 0x3005, ov7251->fsin_role == 1 ? 0x02 : 0x00 },
+		{ 0x3027, 0x00 }, /* Natural VSYNC, no software pin override. */
+		{ 0x3666, ov7251->fsin_role ? 0x00 : 0x0a },
+		{ 0x3823, ov7251->fsin_role == 2 ? 0x30 :
+			  ov7251->fsin_role == 1 ? 0x10 : 0x00 },
+		{ 0x3824, 0x01 }, { 0x3825, 0x07 },
+		{ 0x3826, 0x00 }, { 0x3827, 0x00 },
+		{ 0x3b80, 0x00 }, { 0x3b81, 0x00 }, { 0x3b96, 0x00 },
+	};
+	static const char * const names[] = { "off", "master", "slave" };
+	unsigned int i;
+	u8 value;
+	int ret;
+
+	if (!device_property_present(ov7251->dev, "ovti,fsin-role"))
+		return 0;
+
+	ret = ov7251_set_register_array(ov7251, regs, ARRAY_SIZE(regs));
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = ov7251_read_reg(ov7251, regs[i].reg, &value);
+		if (ret)
+			return ret;
+		if (value != regs[i].val)
+			return dev_err_probe(ov7251->dev, -EIO,
+				"frame-sync readback mismatch at 0x%04x\n",
+				regs[i].reg);
+	}
+	dev_info(ov7251->dev,
+		 "coral-camera sync-role=%s io=0x%02x mux=0x%02x timing=0x%02x cs-reset=0x0107 r-reset=0x0000 strobe=off verified=1\n",
+		 names[ov7251->fsin_role], regs[0].val, regs[2].val, regs[3].val);
+	return 0;
+}
