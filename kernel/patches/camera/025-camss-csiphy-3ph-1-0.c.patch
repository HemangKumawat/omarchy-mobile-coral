+static u8 csiphy_combo_lane_mask(struct csiphy_device *csiphy)
+{
+	/* PHY3 endpoint0: data0 + clock0, endpoint1: data2 + clock1. */
+	return csiphy->shared_phy ? BIT(4) | BIT(6) : BIT(0) | BIT(7);
+}
+
+static void csiphy_sm8150_combo_enable(struct csiphy_device *csiphy,
+				      u16 settle_cnt)
+{
+	u32 offset = csiphy->regs->offset;
+	u32 reg = CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(offset, 5);
+	u8 val = readl_relaxed(csiphy->base + reg);
+	int group = !!csiphy->shared_phy;
+	int i;
+
+	/* All calls are serialized with the physical owner's combo_lock. */
+	writel_relaxed(val | csiphy_combo_lane_mask(csiphy), csiphy->base + reg);
+	if (!val) {
+		writel_relaxed(1, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(offset, 6));
+		writel_relaxed(2, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(offset, 7));
+		writel_relaxed(1, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(offset, 0));
+		usleep_range(1000, 1100);
+		writel_relaxed(0, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(offset, 0));
+	}
+
+	/* Never reprogram the other stream's data or clock receiver. */
+	csiphy_gen2_write_regs(csiphy, lane_regs_sm8150_combo[group],
+			       ARRAY_SIZE(lane_regs_sm8150_combo[group]), settle_cnt);
+	if (!val) {
+		for (i = 11; i < 22; i++)
+			writel_relaxed(0, csiphy->base +
+				       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(offset, i));
+	}
+}
