From fec403571c23 Mon Sep 17 00:00:00 2001
From: Hemang Kumawat <HemangKumawat@users.noreply.github.com>
Date: Mon, 19 Oct 2026 21:56:34 +0200
Subject: [PATCH 11] drm/msm/dsi: retain powered link clocks and serialize brightness

Keep clock rates and the OPP vote owned by host power-on/off instead of changing them around every command. Serialize panel brightness against panel state transitions and restore the original LP/HS flags on every return. Six fresh exact-image RAM boots and 240 idle/brightness wake cycles passed with zero true FIFO faults.

Source commit: fec403571c23 (diff against d3dd05299ff8).
Assisted-by: AI agents (Codex, Claude) under the author's direction
---
 drivers/gpu/drm/msm/dsi/dsi_host.c            |  7 ++----
 drivers/gpu/drm/panel/panel-samsung-s6e3hc2.c | 33 +++++++++++++++------------
 2 files changed, 21 insertions(+), 19 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 0ee1ebf9c1e2dd9b7d7459ae0edb4b10536565f5..24a16218d66a141daba9c5a1e8ae20ef2bbce737 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -2154,7 +2154,6 @@ int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 				const struct mipi_dsi_msg *msg)
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
-	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
 
 	/* TODO: make sure dsi_cmd_mdp is idle.
 	 * Since DSI6G v1.2.0, we can set DSI_TRIG_CTRL.BLOCK_DMA_WITHIN_FRAME
@@ -2167,8 +2166,7 @@ int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 	 * mdp clock need to be enabled to receive dsi interrupt
 	 */
 	pm_runtime_get_sync(&msm_host->pdev->dev);
-	cfg_hnd->ops->link_clk_set_rate(msm_host);
-	cfg_hnd->ops->link_clk_enable(msm_host);
+	/* power_on holds link clocks and the OPP vote until power_off. */
 
 	/* TODO: vote for bus bandwidth */
 
@@ -2189,7 +2187,6 @@ void msm_dsi_host_xfer_restore(struct mipi_dsi_host *host,
 				const struct mipi_dsi_msg *msg)
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
-	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
 
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_CMD_DMA_DONE, 0);
 	dsi_write(msm_host, REG_DSI_CTRL, msm_host->dma_cmd_ctrl_restore);
@@ -2199,7 +2196,6 @@ void msm_dsi_host_xfer_restore(struct mipi_dsi_host *host,
 
 	/* TODO: unvote for bus bandwidth */
 
-	cfg_hnd->ops->link_clk_disable(msm_host);
 	pm_runtime_put(&msm_host->pdev->dev);
 }
 
@@ -2501,6 +2497,7 @@ int msm_dsi_host_power_on(struct mipi_dsi_host *host,
 		goto unlock_ret;
 	}
 
+	/* Keep link clocks and the OPP vote for the entire powered interval. */
 	pm_runtime_get_sync(&msm_host->pdev->dev);
 	ret = cfg_hnd->ops->link_clk_set_rate(msm_host);
 	if (!ret)
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3hc2.c b/drivers/gpu/drm/panel/panel-samsung-s6e3hc2.c
index f2340261946cfde6247c83ff0c3b936ec321010e..d73813b88548aaf5c674b6e49772013e8cea5328 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6e3hc2.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3hc2.c
@@ -287,37 +287,42 @@ static const struct drm_panel_funcs s6e3hc2_panel_funcs = {
 static int s6e3hc2_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct s6e3hc2 *ctx = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
+	unsigned long mode_flags;
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	guard(mutex)(&ctx->lock);
+	/* backlight_enable() replays cached brightness after panel enable. */
+	if (!ctx->powered || !ctx->power_mode_available)
+		return 0;
 
+	mode_flags = dsi->mode_flags;
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
+	dsi->mode_flags = mode_flags;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return 0;
+	return ret < 0 ? ret : 0;
 }
 
-// TODO: Check if /sys/class/backlight/.../actual_brightness actually returns
-// correct values. If not, remove this function.
 static int s6e3hc2_bl_get_brightness(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct s6e3hc2 *ctx = mipi_dsi_get_drvdata(dsi);
+	unsigned long mode_flags;
 	u16 brightness;
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	guard(mutex)(&ctx->lock);
+	if (!ctx->powered || !ctx->power_mode_available)
+		return -EHOSTDOWN;
 
+	mode_flags = dsi->mode_flags;
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-	if (ret < 0)
-		return ret;
-
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	dsi->mode_flags = mode_flags;
 
-	return brightness;
+	return ret < 0 ? ret : brightness;
 }
 
 static const struct backlight_ops s6e3hc2_bl_ops = {
