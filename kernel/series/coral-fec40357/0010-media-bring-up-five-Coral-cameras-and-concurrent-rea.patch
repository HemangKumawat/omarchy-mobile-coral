--- /dev/null
+++ b/drivers/media/i2c/imx520.c
@@ -0,0 +1,1165 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony IMX520 camera sensor driver
+ *
+ * Copyright (C) 2021 Intel Corporation
+ * Copyright (C) 2026 OnePlus 7T Pro Linux contributors
+ */
+#include <linux/unaligned.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+/* Streaming Mode */
+#define IMX520_REG_MODE_SELECT	0x0100
+#define IMX520_MODE_STANDBY	0x00
+#define IMX520_MODE_STREAMING	0x01
+
+/* Lines per frame */
+#define IMX520_REG_LPFR		0x0340
+
+/* Chip ID */
+#define IMX520_REG_ID		0x0016
+#define IMX520_ID		0x0520
+
+/* Exposure control */
+#define IMX520_REG_EXPOSURE_CIT	0x0202
+#define IMX520_EXPOSURE_MIN	1
+#define IMX520_EXPOSURE_OFFSET	10
+#define IMX520_EXPOSURE_STEP	1
+#define IMX520_EXPOSURE_DEFAULT	0x0a0c
+
+/* Analog gain control */
+#define IMX520_REG_AGAIN	0x0204
+#define IMX520_AGAIN_MIN	0
+#define IMX520_AGAIN_MAX	960
+#define IMX520_AGAIN_STEP	1
+#define IMX520_AGAIN_DEFAULT	0
+
+/* Group hold register */
+#define IMX520_REG_HOLD		0x0104
+
+/* Input clock rate */
+#define IMX520_INCLK_RATE	24000000
+
+#define IMX520_VANA_MIN_UV	2800000
+#define IMX520_VANA_MAX_UV	2800000
+#define IMX520_VDIG_LOAD_UA	1100000
+
+/* CSI2 HW configuration */
+#define IMX520_LINK_FREQ	675000000
+#define IMX520_NUM_DATA_LANES	2
+
+#define IMX520_REG_MIN		0x00
+#define IMX520_REG_MAX		0xffff
+
+/**
+ * struct imx520_reg - imx520 sensor register
+ * @address: Register address
+ * @val: Register value
+ */
+struct imx520_reg {
+	u16 address;
+	u8 val;
+};
+
+/**
+ * struct imx520_reg_list - imx520 sensor register list
+ * @num_of_regs: Number of registers in the list
+ * @regs: Pointer to register list
+ */
+struct imx520_reg_list {
+	u32 num_of_regs;
+	const struct imx520_reg *regs;
+};
+
+/**
+ * struct imx520_mode - imx520 sensor mode structure
+ * @width: Frame width
+ * @height: Frame height
+ * @code: Format code
+ * @hblank: Horizontal blanking in lines
+ * @vblank: Vertical blanking in lines
+ * @vblank_min: Minimum vertical blanking in lines
+ * @vblank_max: Maximum vertical blanking in lines
+ * @pclk: Sensor pixel clock
+ * @link_freq_idx: Link frequency index
+ * @reg_list: Register list for sensor mode
+ */
+struct imx520_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	u32 hblank;
+	u32 vblank;
+	u32 vblank_min;
+	u32 vblank_max;
+	u64 pclk;
+	u32 link_freq_idx;
+	struct imx520_reg_list reg_list;
+};
+
+/**
+ * struct imx520 - imx520 sensor device structure
+ * @dev: Pointer to generic device
+ * @client: Pointer to i2c client
+ * @sd: V4L2 sub-device
+ * @pad: Media pad. Only one pad supported
+ * @reset_gpio: Sensor reset gpio
+ * @vana_enable_gpio: Board analogue-rail gate gpio
+ * @inclk: Sensor input clock
+ * @vana: Analogue regulator
+ * @vdig: Digital regulator
+ * @vio: I/O regulator
+ * @ctrl_handler: V4L2 control handler
+ * @link_freq_ctrl: Pointer to link frequency control
+ * @pclk_ctrl: Pointer to pixel clock control
+ * @hblank_ctrl: Pointer to horizontal blanking control
+ * @vblank_ctrl: Pointer to vertical blanking control
+ * @exp_ctrl: Pointer to exposure control
+ * @again_ctrl: Pointer to analog gain control
+ * @vblank: Vertical blanking in lines
+ * @cur_mode: Pointer to current selected sensor mode
+ * @mutex: Mutex for serializing sensor controls
+ */
+struct imx520 {
+	struct device *dev;
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *vana_enable_gpio;
+	struct clk *inclk;
+	struct regulator *vana;
+	struct regulator *vdig;
+	struct regulator *vio;
+	struct regulator_bulk_data auxiliary[2];
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq_ctrl;
+	struct v4l2_ctrl *pclk_ctrl;
+	struct v4l2_ctrl *hblank_ctrl;
+	struct v4l2_ctrl *vblank_ctrl;
+	struct {
+		struct v4l2_ctrl *exp_ctrl;
+		struct v4l2_ctrl *again_ctrl;
+	};
+	u32 vblank;
+	const struct imx520_mode *cur_mode;
+	/* Serializes controls and streaming state. */
+	struct mutex mutex;
+};
+
+static const s64 link_freq[] = {
+	IMX520_LINK_FREQ,
+};
+
+#include "imx520-coral-tables.h"
+
+/**
+ * to_imx520() - imx520 V4L2 sub-device to imx520 device.
+ * @subdev: pointer to imx520 V4L2 sub-device
+ *
+ * Return: pointer to imx520 device
+ */
+static inline struct imx520 *to_imx520(struct v4l2_subdev *subdev)
+{
+	return container_of(subdev, struct imx520, sd);
+}
+
+/**
+ * imx520_read_reg() - Read registers.
+ * @imx520: pointer to imx520 device
+ * @reg: register address
+ * @len: length of bytes to read. Max supported bytes is 4
+ * @val: pointer to register value to be filled.
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_read_reg(struct imx520 *imx520, u16 reg, u32 len, u32 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx520->sd);
+	struct i2c_msg msgs[2] = {0};
+	u8 addr_buf[2] = {0};
+	u8 data_buf[4] = {0};
+	int ret;
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, addr_buf);
+
+	/* Write register address */
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = ARRAY_SIZE(addr_buf);
+	msgs[0].buf = addr_buf;
+
+	/* Read data from register */
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_buf[4 - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = get_unaligned_be32(data_buf);
+
+	return 0;
+}
+
+/**
+ * imx520_write_reg() - Write register
+ * @imx520: pointer to imx520 device
+ * @reg: register address
+ * @len: length of bytes. Max supported bytes is 4
+ * @val: register value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_write_reg(struct imx520 *imx520, u16 reg, u32 len, u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx520->sd);
+	u8 buf[6] = {0};
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, buf);
+	put_unaligned_be32(val << (8 * (4 - len)), buf + 2);
+	if (i2c_master_send(client, buf, len + 2) != len + 2)
+		return -EIO;
+
+	return 0;
+}
+
+/**
+ * imx520_write_regs() - Write a list of registers
+ * @imx520: pointer to imx520 device
+ * @regs: list of registers to be written
+ * @len: length of registers array
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_write_regs(struct imx520 *imx520,
+			     const struct imx520_reg *regs, u32 len)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < len; i++) {
+		ret = imx520_write_reg(imx520, regs[i].address, 1, regs[i].val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * imx520_update_controls() - Update control ranges based on streaming mode
+ * @imx520: pointer to imx520 device
+ * @mode: pointer to imx520_mode sensor mode
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_update_controls(struct imx520 *imx520,
+				  const struct imx520_mode *mode)
+{
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx520->link_freq_ctrl, mode->link_freq_idx);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx520->hblank_ctrl, mode->hblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_modify_range(imx520->vblank_ctrl, mode->vblank_min,
+					mode->vblank_max, 1, mode->vblank);
+}
+
+/**
+ * imx520_update_exp_gain() - Set updated exposure and gain
+ * @imx520: pointer to imx520 device
+ * @exposure: updated exposure value
+ * @gain: updated analog gain value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_update_exp_gain(struct imx520 *imx520, u32 exposure, u32 gain)
+{
+	u32 lpfr;
+	int ret;
+
+	lpfr = imx520->vblank + imx520->cur_mode->height;
+
+	dev_dbg(imx520->dev, "Set exp %u, analog gain %u, lpfr %u\n",
+		exposure, gain, lpfr);
+
+	ret = imx520_write_reg(imx520, IMX520_REG_HOLD, 1, 1);
+	if (ret)
+		return ret;
+
+	ret = imx520_write_reg(imx520, IMX520_REG_LPFR, 2, lpfr);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx520_write_reg(imx520, IMX520_REG_EXPOSURE_CIT, 2, exposure);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx520_write_reg(imx520, IMX520_REG_AGAIN, 2, gain);
+
+error_release_group_hold:
+	imx520_write_reg(imx520, IMX520_REG_HOLD, 1, 0);
+
+	return ret;
+}
+
+/**
+ * imx520_set_ctrl() - Set subdevice control
+ * @ctrl: pointer to v4l2_ctrl structure
+ *
+ * Supported controls:
+ * - V4L2_CID_VBLANK
+ * - cluster controls:
+ *   - V4L2_CID_ANALOGUE_GAIN
+ *   - V4L2_CID_EXPOSURE
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx520 *imx520 =
+		container_of(ctrl->handler, struct imx520, ctrl_handler);
+	u32 analog_gain;
+	u32 exposure;
+	int ret;
+
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		imx520->vblank = imx520->vblank_ctrl->val;
+
+		dev_dbg(imx520->dev, "Received vblank %u, new lpfr %u\n",
+			imx520->vblank,
+			imx520->vblank + imx520->cur_mode->height);
+
+		ret = __v4l2_ctrl_modify_range(imx520->exp_ctrl,
+					       IMX520_EXPOSURE_MIN,
+					       imx520->vblank +
+					       imx520->cur_mode->height -
+					       IMX520_EXPOSURE_OFFSET,
+					       1, IMX520_EXPOSURE_DEFAULT);
+		break;
+	case V4L2_CID_EXPOSURE:
+		/* Set controls only if sensor is in power on state */
+		if (!pm_runtime_get_if_in_use(imx520->dev))
+			return 0;
+
+		exposure = ctrl->val;
+		analog_gain = imx520->again_ctrl->val;
+
+		dev_dbg(imx520->dev, "Received exp %u, analog gain %u\n",
+			exposure, analog_gain);
+
+		ret = imx520_update_exp_gain(imx520, exposure, analog_gain);
+
+		pm_runtime_put(imx520->dev);
+
+		break;
+	default:
+		dev_err(imx520->dev, "Invalid control %d\n", ctrl->id);
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
+
+/* V4l2 subdevice control ops*/
+static const struct v4l2_ctrl_ops imx520_ctrl_ops = {
+	.s_ctrl = imx520_set_ctrl,
+};
+
+/**
+ * imx520_enum_mbus_code() - Enumerate V4L2 sub-device mbus codes
+ * @sd: pointer to imx520 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @code: V4L2 sub-device code enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = supported_mode.code;
+
+	return 0;
+}
+
+/**
+ * imx520_enum_frame_size() - Enumerate V4L2 sub-device frame sizes
+ * @sd: pointer to imx520 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fsize: V4L2 sub-device size enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fsize)
+{
+	if (fsize->index > 0)
+		return -EINVAL;
+
+	if (fsize->code != supported_mode.code)
+		return -EINVAL;
+
+	fsize->min_width = supported_mode.width;
+	fsize->max_width = fsize->min_width;
+	fsize->min_height = supported_mode.height;
+	fsize->max_height = fsize->min_height;
+
+	return 0;
+}
+
+/**
+ * imx520_fill_pad_format() - Fill subdevice pad format
+ *                            from selected sensor mode
+ * @imx520: pointer to imx520 device
+ * @mode: pointer to imx520_mode sensor mode
+ * @fmt: V4L2 sub-device format need to be filled
+ */
+static void imx520_fill_pad_format(struct imx520 *imx520,
+				   const struct imx520_mode *mode,
+				   struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = mode->code;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->format.quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+/**
+ * imx520_get_pad_format() - Get subdevice pad format
+ * @sd: pointer to imx520 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx520 *imx520 = to_imx520(sd);
+
+	mutex_lock(&imx520->mutex);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		fmt->format = *framefmt;
+	} else {
+		imx520_fill_pad_format(imx520, imx520->cur_mode, fmt);
+	}
+
+	mutex_unlock(&imx520->mutex);
+
+	return 0;
+}
+
+/**
+ * imx520_set_pad_format() - Set subdevice pad format
+ * @sd: pointer to imx520 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx520 *imx520 = to_imx520(sd);
+	const struct imx520_mode *mode;
+	int ret = 0;
+
+	mutex_lock(&imx520->mutex);
+
+	mode = &supported_mode;
+	imx520_fill_pad_format(imx520, mode, fmt);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		*framefmt = fmt->format;
+	} else {
+		ret = imx520_update_controls(imx520, mode);
+		if (!ret)
+			imx520->cur_mode = mode;
+	}
+
+	mutex_unlock(&imx520->mutex);
+
+	return ret;
+}
+
+static int imx520_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	if (sel->which != V4L2_SUBDEV_FORMAT_ACTIVE)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r = (struct v4l2_rect) { 0, 0, 4656, 3496 };
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/**
+ * imx520_init_state() - Initialize sub-device state
+ * @sd: pointer to imx520 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	struct imx520 *imx520 = to_imx520(sd);
+	struct v4l2_subdev_format fmt = { 0 };
+
+	fmt.which = sd_state ? V4L2_SUBDEV_FORMAT_TRY : V4L2_SUBDEV_FORMAT_ACTIVE;
+	imx520_fill_pad_format(imx520, &supported_mode, &fmt);
+
+	return imx520_set_pad_format(sd, sd_state, &fmt);
+}
+
+/**
+ * imx520_start_streaming() - Start sensor stream
+ * @imx520: pointer to imx520 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_start_streaming(struct imx520 *imx520)
+{
+	const struct imx520_reg_list *reg_list;
+	int ret;
+
+	ret = imx520_write_regs(imx520, imx520_init_regs,
+				ARRAY_SIZE(imx520_init_regs));
+	if (ret) {
+		dev_err(imx520->dev, "failed to write global registers\n");
+		return ret;
+	}
+
+	/* Write sensor mode registers */
+	reg_list = &imx520->cur_mode->reg_list;
+	ret = imx520_write_regs(imx520, reg_list->regs,
+				reg_list->num_of_regs);
+	if (ret) {
+		dev_err(imx520->dev, "failed to write mode registers\n");
+		return ret;
+	}
+
+	/* Setup handler will write actual exposure and gain */
+	ret =  __v4l2_ctrl_handler_setup(imx520->sd.ctrl_handler);
+	if (ret) {
+		dev_err(imx520->dev, "fail to setup handler\n");
+		return ret;
+	}
+
+	/* Start streaming */
+	ret = imx520_write_reg(imx520, IMX520_REG_MODE_SELECT,
+			       1, IMX520_MODE_STREAMING);
+	if (ret) {
+		dev_err(imx520->dev, "failed to start streaming\n");
+		return ret;
+	}
+
+	dev_info(imx520->dev, "streaming 4656x3496 RAW10 over four-lane D-PHY\n");
+
+	return 0;
+}
+
+/**
+ * imx520_stop_streaming() - Stop sensor stream
+ * @imx520: pointer to imx520 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_stop_streaming(struct imx520 *imx520)
+{
+	return imx520_write_reg(imx520, IMX520_REG_MODE_SELECT,
+				1, IMX520_MODE_STANDBY);
+}
+
+/**
+ * imx520_set_stream() - Enable sensor streaming
+ * @sd: pointer to imx520 subdevice
+ * @enable: set to enable sensor streaming
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx520 *imx520 = to_imx520(sd);
+	int ret;
+
+	mutex_lock(&imx520->mutex);
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(imx520->dev);
+		if (ret)
+			goto error_unlock;
+
+		ret = imx520_start_streaming(imx520);
+		if (ret)
+			goto error_power_off;
+	} else {
+		imx520_stop_streaming(imx520);
+		pm_runtime_put(imx520->dev);
+	}
+
+	mutex_unlock(&imx520->mutex);
+
+	return 0;
+
+error_power_off:
+	pm_runtime_put(imx520->dev);
+error_unlock:
+	mutex_unlock(&imx520->mutex);
+
+	return ret;
+}
+
+/**
+ * imx520_detect() - Detect imx520 sensor
+ * @imx520: pointer to imx520 device
+ *
+ * Return: 0 if successful, -EIO if sensor id does not match
+ */
+static int imx520_detect(struct imx520 *imx520)
+{
+	int ret;
+	u32 val;
+
+	ret = imx520_read_reg(imx520, IMX520_REG_ID, 2, &val);
+	if (ret)
+		return ret;
+
+	if (val != IMX520_ID) {
+		dev_err(imx520->dev, "chip id mismatch: %x!=%x\n",
+			IMX520_ID, val);
+		return -ENXIO;
+	}
+
+	dev_info(imx520->dev, "coral-camera chip-id=0x%04x\n", val);
+	return 0;
+}
+
+/**
+ * imx520_parse_hw_config() - Parse HW configuration and check if supported
+ * @imx520: pointer to imx520 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_parse_hw_config(struct imx520 *imx520)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx520->dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	struct fwnode_handle *ep;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	/* The GPIO values are logical; reset is active low in the DT. */
+	imx520->reset_gpio = devm_gpiod_get(imx520->dev, "reset",
+					    GPIOD_OUT_HIGH);
+	if (IS_ERR(imx520->reset_gpio)) {
+		dev_err(imx520->dev, "failed to get reset gpio %ld\n",
+			PTR_ERR(imx520->reset_gpio));
+		return PTR_ERR(imx520->reset_gpio);
+	}
+
+	imx520->vana_enable_gpio = devm_gpiod_get_optional(imx520->dev, "vana-enable",
+						  GPIOD_OUT_LOW);
+	if (IS_ERR(imx520->vana_enable_gpio))
+		return dev_err_probe(imx520->dev,
+				     PTR_ERR(imx520->vana_enable_gpio),
+				     "failed to get VANA enable GPIO\n");
+
+	/* Get sensor input clock */
+	imx520->inclk = devm_clk_get(imx520->dev, NULL);
+	if (IS_ERR(imx520->inclk)) {
+		dev_err(imx520->dev, "could not get inclk\n");
+		return PTR_ERR(imx520->inclk);
+	}
+
+	ret = clk_set_rate(imx520->inclk, IMX520_INCLK_RATE);
+	if (ret)
+		return dev_err_probe(imx520->dev, ret,
+				     "could not set 24 MHz input clock\n");
+
+	rate = clk_get_rate(imx520->inclk);
+	if (rate != IMX520_INCLK_RATE) {
+		dev_err(imx520->dev, "inclk frequency mismatch\n");
+		return -EINVAL;
+	}
+
+	imx520->vana = devm_regulator_get(imx520->dev, "vana");
+	if (IS_ERR(imx520->vana))
+		return dev_err_probe(imx520->dev, PTR_ERR(imx520->vana),
+				     "failed to get VANA\n");
+
+	imx520->vdig = devm_regulator_get(imx520->dev, "vdig");
+	if (IS_ERR(imx520->vdig))
+		return dev_err_probe(imx520->dev, PTR_ERR(imx520->vdig),
+				     "failed to get VDIG\n");
+
+	imx520->vio = devm_regulator_get(imx520->dev, "vio");
+	if (IS_ERR(imx520->vio))
+		return dev_err_probe(imx520->dev, PTR_ERR(imx520->vio),
+				     "failed to get VIO\n");
+
+	imx520->auxiliary[0].supply = "vextra0";
+	imx520->auxiliary[1].supply = "vextra1";
+	ret = devm_regulator_bulk_get(imx520->dev, ARRAY_SIZE(imx520->auxiliary),
+				      imx520->auxiliary);
+	if (ret)
+		return dev_err_probe(imx520->dev, ret, "failed to get module supplies\n");
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus_type != V4L2_MBUS_CSI2_DPHY) {
+		dev_err(imx520->dev, "endpoint must use D-PHY\n");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX520_NUM_DATA_LANES) {
+		dev_err(imx520->dev,
+			"number of CSI2 data lanes %d is not supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(imx520->dev, "no link frequencies defined\n");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	for (i = 0; i < bus_cfg.nr_of_link_frequencies; i++)
+		if (bus_cfg.link_frequencies[i] == IMX520_LINK_FREQ)
+			goto done_endpoint_free;
+
+	ret = -EINVAL;
+
+done_endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/* V4l2 subdevice ops */
+static const struct v4l2_subdev_video_ops imx520_video_ops = {
+	.s_stream = imx520_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx520_pad_ops = {
+	.enum_mbus_code = imx520_enum_mbus_code,
+	.enum_frame_size = imx520_enum_frame_size,
+	.get_fmt = imx520_get_pad_format,
+	.set_fmt = imx520_set_pad_format,
+	.get_selection = imx520_get_selection,
+};
+
+static const struct v4l2_subdev_ops imx520_subdev_ops = {
+	.video = &imx520_video_ops,
+	.pad = &imx520_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx520_internal_ops = {
+	.init_state = imx520_init_state,
+};
+
+/**
+ * imx520_power_on() - Sensor power on sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx520 *imx520 = to_imx520(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx520->auxiliary), imx520->auxiliary);
+	if (ret)
+		return ret;
+
+	ret = regulator_set_voltage(imx520->vana, IMX520_VANA_MIN_UV,
+				    IMX520_VANA_MAX_UV);
+	if (ret)
+		goto error_auxiliary;
+
+	ret = regulator_enable(imx520->vana);
+	if (ret)
+		goto error_vana_voltage;
+
+	gpiod_set_value_cansleep(imx520->vana_enable_gpio, 1);
+	usleep_range(1000, 2000);
+
+	ret = regulator_set_load(imx520->vdig, IMX520_VDIG_LOAD_UA);
+	if (ret)
+		goto error_vana;
+
+	ret = regulator_enable(imx520->vdig);
+	if (ret)
+		goto error_vdig_load;
+	usleep_range(1000, 2000);
+
+	ret = regulator_enable(imx520->vio);
+	if (ret)
+		goto error_vdig;
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(imx520->inclk);
+	if (ret) {
+		dev_err(imx520->dev, "failed to enable input clock\n");
+		goto error_vio;
+	}
+
+	usleep_range(1000, 1200);
+	gpiod_set_value_cansleep(imx520->reset_gpio, 0);
+	usleep_range(1000, 2000);
+
+	return 0;
+
+error_vio:
+	regulator_disable(imx520->vio);
+error_vdig:
+	regulator_disable(imx520->vdig);
+error_vdig_load:
+	regulator_set_load(imx520->vdig, 0);
+error_vana:
+	gpiod_set_value_cansleep(imx520->vana_enable_gpio, 0);
+	regulator_disable(imx520->vana);
+error_vana_voltage:
+	regulator_set_voltage(imx520->vana, 0, IMX520_VANA_MAX_UV);
+error_auxiliary:
+	regulator_bulk_disable(ARRAY_SIZE(imx520->auxiliary), imx520->auxiliary);
+
+	return ret;
+}
+
+/**
+ * imx520_power_off() - Sensor power off sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx520 *imx520 = to_imx520(sd);
+
+	gpiod_set_value_cansleep(imx520->reset_gpio, 1);
+	clk_disable_unprepare(imx520->inclk);
+	regulator_disable(imx520->vio);
+	regulator_disable(imx520->vdig);
+	regulator_set_load(imx520->vdig, 0);
+	gpiod_set_value_cansleep(imx520->vana_enable_gpio, 0);
+	regulator_disable(imx520->vana);
+	regulator_set_voltage(imx520->vana, 0, IMX520_VANA_MAX_UV);
+	regulator_bulk_disable(ARRAY_SIZE(imx520->auxiliary), imx520->auxiliary);
+
+	return 0;
+}
+
+/**
+ * imx520_init_controls() - Initialize sensor subdevice controls
+ * @imx520: pointer to imx520 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_init_controls(struct imx520 *imx520)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx520->ctrl_handler;
+	const struct imx520_mode *mode = imx520->cur_mode;
+	struct v4l2_fwnode_device_properties props;
+	u32 lpfr;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 8);
+	if (ret)
+		return ret;
+
+	/* Serialize controls with sensor device */
+	ctrl_hdlr->lock = &imx520->mutex;
+
+	/* Initialize exposure and gain */
+	lpfr = mode->vblank + mode->height;
+	imx520->exp_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					     &imx520_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX520_EXPOSURE_MIN,
+					     lpfr - IMX520_EXPOSURE_OFFSET,
+					     IMX520_EXPOSURE_STEP,
+					     IMX520_EXPOSURE_DEFAULT);
+
+	imx520->again_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					       &imx520_ctrl_ops,
+					       V4L2_CID_ANALOGUE_GAIN,
+					       IMX520_AGAIN_MIN,
+					       IMX520_AGAIN_MAX,
+					       IMX520_AGAIN_STEP,
+					       IMX520_AGAIN_DEFAULT);
+
+	v4l2_ctrl_cluster(2, &imx520->exp_ctrl);
+
+	imx520->vblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx520_ctrl_ops,
+						V4L2_CID_VBLANK,
+						mode->vblank_min,
+						mode->vblank_max,
+						1, mode->vblank);
+
+	/* Read only controls */
+	imx520->pclk_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					      &imx520_ctrl_ops,
+					      V4L2_CID_PIXEL_RATE,
+					      mode->pclk, mode->pclk,
+					      1, mode->pclk);
+
+	imx520->link_freq_ctrl = v4l2_ctrl_new_int_menu(ctrl_hdlr,
+							&imx520_ctrl_ops,
+							V4L2_CID_LINK_FREQ,
+							ARRAY_SIZE(link_freq) -
+							1,
+							mode->link_freq_idx,
+							link_freq);
+	if (imx520->link_freq_ctrl)
+		imx520->link_freq_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx520->hblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx520_ctrl_ops,
+						V4L2_CID_HBLANK,
+						IMX520_REG_MIN,
+						IMX520_REG_MAX,
+						1, mode->hblank);
+	if (imx520->hblank_ctrl)
+		imx520->hblank_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ret = v4l2_fwnode_device_parse(imx520->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &imx520_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		dev_err(imx520->dev, "control init failed: %d\n",
+			ret);
+		goto error_free_hdlr;
+	}
+
+	imx520->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+/**
+ * imx520_probe() - I2C client device binding
+ * @client: pointer to i2c client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx520_probe(struct i2c_client *client)
+{
+	struct imx520 *imx520;
+	const char *name;
+	int ret;
+
+	imx520 = devm_kzalloc(&client->dev, sizeof(*imx520), GFP_KERNEL);
+	if (!imx520)
+		return -ENOMEM;
+
+	imx520->dev = &client->dev;
+	name = device_get_match_data(&client->dev);
+	if (!name)
+		return -ENODEV;
+
+	/* Initialize subdev */
+	v4l2_i2c_subdev_init(&imx520->sd, client, &imx520_subdev_ops);
+	imx520->sd.internal_ops = &imx520_internal_ops;
+
+	ret = imx520_parse_hw_config(imx520);
+	if (ret) {
+		dev_err(imx520->dev, "HW configuration is not supported\n");
+		return ret;
+	}
+
+	mutex_init(&imx520->mutex);
+
+	ret = imx520_power_on(imx520->dev);
+	if (ret) {
+		dev_err(imx520->dev, "failed to power-on the sensor\n");
+		goto error_mutex_destroy;
+	}
+
+	/* Check module identity */
+	ret = imx520_detect(imx520);
+	if (ret) {
+		dev_err(imx520->dev, "failed to find sensor: %d\n", ret);
+		goto error_power_off;
+	}
+
+	/* Set default mode to max resolution */
+	imx520->cur_mode = &supported_mode;
+	imx520->vblank = imx520->cur_mode->vblank;
+
+	ret = imx520_init_controls(imx520);
+	if (ret) {
+		dev_err(imx520->dev, "failed to init controls: %d\n", ret);
+		goto error_power_off;
+	}
+
+	/* Initialize subdev */
+	imx520->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx520->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	v4l2_i2c_subdev_set_name(&imx520->sd, client, name, NULL);
+
+	/* Initialize source pad */
+	imx520->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&imx520->sd.entity, 1, &imx520->pad);
+	if (ret) {
+		dev_err(imx520->dev, "failed to init entity pads: %d\n", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&imx520->sd);
+	if (ret < 0) {
+		dev_err(imx520->dev,
+			"failed to register async subdev: %d\n", ret);
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(imx520->dev);
+	pm_runtime_enable(imx520->dev);
+	pm_runtime_idle(imx520->dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&imx520->sd.entity);
+error_handler_free:
+	v4l2_ctrl_handler_free(imx520->sd.ctrl_handler);
+error_power_off:
+	imx520_power_off(imx520->dev);
+error_mutex_destroy:
+	mutex_destroy(&imx520->mutex);
+
+	return ret;
+}
+
+/**
+ * imx520_remove() - I2C client device unbinding
+ * @client: pointer to I2C client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static void imx520_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx520 *imx520 = to_imx520(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx520_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+
+	mutex_destroy(&imx520->mutex);
+}
+
+static const struct dev_pm_ops imx520_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx520_power_off, imx520_power_on, NULL)
+};
+
+static const struct of_device_id imx520_of_match[] = {
+	{ .compatible = "sony,imx520", .data = "imx520" },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(of, imx520_of_match);
+
+static struct i2c_driver imx520_driver = {
+	.probe = imx520_probe,
+	.remove = imx520_remove,
+	.driver = {
+		.name = "imx520",
+		.pm = &imx520_pm_ops,
+		.of_match_table = imx520_of_match,
+	},
+};
+
+module_i2c_driver(imx520_driver);
+
+MODULE_DESCRIPTION("Sony IMX520 sensor driver");
+MODULE_LICENSE("GPL");
