+/* One module owns both resets from probe, before either sensor leaves reset. */
+static int ov7251_get_enable_gpio(struct ov7251 *ov7251)
+{
+	struct device *dev = ov7251->dev;
+	struct device_node *node;
+	struct i2c_client *provider;
+	struct v4l2_subdev *sd;
+	struct ov7251 *lead;
+	struct device_link *link;
+
+	node = of_parse_phandle(dev->of_node, "ovti,reset-provider", 0);
+	if (!node) {
+		ov7251->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+		if (IS_ERR(ov7251->enable_gpio))
+			return PTR_ERR(ov7251->enable_gpio);
+		ov7251->peer_enable_gpio = devm_gpiod_get_optional(dev, "peer-enable",
+							       GPIOD_OUT_LOW);
+		return PTR_ERR_OR_ZERO(ov7251->peer_enable_gpio);
+	}
+	if (!of_device_is_compatible(node, "ovti,ov7251")) {
+		of_node_put(node);
+		return -EINVAL;
+	}
+	provider = of_find_i2c_device_by_node(node);
+	of_node_put(node);
+	if (!provider)
+		return -EPROBE_DEFER;
+	if (!device_is_bound(&provider->dev)) {
+		put_device(&provider->dev);
+		return -EPROBE_DEFER;
+	}
+	sd = i2c_get_clientdata(provider);
+	lead = sd ? to_ov7251(sd) : NULL;
+	if (!lead || !lead->peer_enable_gpio ||
+	    provider->adapter != ov7251->i2c_client->adapter) {
+		put_device(&provider->dev);
+		return -EINVAL;
+	}
+	link = device_link_add(dev, &provider->dev, DL_FLAG_AUTOREMOVE_CONSUMER);
+	ov7251->enable_gpio = lead->peer_enable_gpio;
+	put_device(&provider->dev);
+	return link ? 0 : -ENOMEM;
+}
