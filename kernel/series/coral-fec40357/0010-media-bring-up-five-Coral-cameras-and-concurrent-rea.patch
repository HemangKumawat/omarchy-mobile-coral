+/* Assign both SCCB aliases: no remapped peer may keep answering factory 0x60. */
+static int ov7251_assign_address(struct ov7251 *ov7251)
+{
+	struct i2c_client *client = ov7251->i2c_client;
+	u8 data[] = { 0x01, 0x03, 0x01 };
+	struct i2c_msg msg = {
+		.addr = ov7251->probe_address,
+		.len = sizeof(data),
+		.buf = data,
+	};
+	int ret;
+
+	/* Software reset must precede address reassignment. */
+	ret = i2c_transfer(client->adapter, &msg, 1);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	usleep_range(1000, 1500);
+	/* SC_REG3B[1] gates the programmable SCCB IDs after reset. */
+	data[0] = 0x30;
+	data[1] = 0x3b;
+	data[2] = 0x02;
+	ret = i2c_transfer(client->adapter, &msg, 1);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	data[0] = 0x01;
+	data[1] = 0x09;
+	data[2] = client->addr << 1;
+	ret = i2c_transfer(client->adapter, &msg, 1);
+	if (ret != 1)
