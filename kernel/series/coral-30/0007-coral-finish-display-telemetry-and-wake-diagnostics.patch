+static int qcom_fg_gen4_clear_dma_errors(struct qcom_fg_chip *chip)
+{
+	u8 status;
+	int ret;
+
+	/* Stock fg_clear_dma_errors_if_any(): DMA_CTL[0] clears sticky logs.
+	 * Deassert before the new transaction so its errors remain observable.
+	 */
+	ret = qcom_fg_read(chip, &status, MEM_IF_DMA_STS(chip), 1);
+	if (ret)
+		return ret;
+	if (status & (BIT(1) | BIT(2))) {
+		dev_warn_ratelimited(chip->dev, "Clearing previous Gen4 DMA errors: %#x\n", status);
+		ret = qcom_fg_masked_write(chip, MEM_IF_DMA_CTL(chip), BIT(0), BIT(0));
+		if (ret)
+			return ret;
+	}
+	ret = qcom_fg_masked_write(chip, MEM_IF_DMA_CTL(chip), BIT(0), 0);
+	if (ret)
+		return ret;
+	ret = qcom_fg_read(chip, &status, MEM_IF_DMA_STS(chip), 1);
+	if (!ret && (status & (BIT(1) | BIT(2))))
+		ret = -EIO;
+	return ret;
+}
