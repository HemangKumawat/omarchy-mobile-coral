+	/* Snapshot before the status handlers clear their W1C registers. */
+	fifo_status = dsi_read(msm_host, REG_DSI_FIFO_STATUS);
+	ack_status = dsi_read(msm_host, REG_DSI_ACK_ERR_STATUS);
+	command = READ_ONCE(msm_host->last_cmd);
+	if (ack_status) {
+		readback_ctrl = dsi_read(msm_host, REG_DSI_RDBK_DATA_CTRL);
+		readback0 = dsi_read(msm_host, REG_DSI_RDBK_DATA(0));
+		readback1 = dsi_read(msm_host, REG_DSI_RDBK_DATA(1));
+	}
+
 	dsi_clk_status(msm_host);
 	dsi_fifo_status(msm_host);
 	dsi_ack_err_status(msm_host);
