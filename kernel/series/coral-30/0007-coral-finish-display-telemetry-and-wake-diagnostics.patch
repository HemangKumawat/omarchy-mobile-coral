+/* Read GPIO46 after all normal device suspend callbacks, before noirq. */
+void msm_pinctrl_coral_uart_snapshot(struct device *dev)
+{
+	struct msm_pinctrl *pctrl = dev_get_drvdata(dev);
+	const struct msm_pingroup *g;
+	unsigned long flags;
+	u32 ctl, io, cfg, status;
+
+	if (!of_machine_is_compatible("google,coral") ||
+	    pctrl->soc->ngroups <= 46)
+		return;
+
+	g = &pctrl->soc->groups[46];
+	raw_spin_lock_irqsave(&pctrl->lock, flags);
+	ctl = msm_readl_ctl(pctrl, g);
+	io = msm_readl_io(pctrl, g);
+	cfg = msm_readl_intr_cfg(pctrl, g);
+	status = msm_readl_intr_status(pctrl, g);
+	raw_spin_unlock_irqrestore(&pctrl->lock, flags);
+
+	dev_info(dev,
+		 "coral-uart suspend-late gpio46 ctl=%08x io=%08x intr_cfg=%08x intr_status=%08x mux=%u pull=%u input=%u oe=%u\n",
+		 ctl, io, cfg, status,
+		 (ctl >> g->mux_bit) & ((1U << order_base_2(g->nfuncs)) - 1),
+		 (ctl >> g->pull_bit) & 3, (io >> g->in_bit) & 1,
+		 (ctl >> g->oe_bit) & 1);
+}
+EXPORT_SYMBOL_GPL(msm_pinctrl_coral_uart_snapshot);
+
