 drivers/clk/qcom/dispcc-sm8250.c                 | 38 ++++++----
 drivers/gpu/drm/msm/dsi/dsi_host.c               | 61 ++++++++++++++--
 drivers/gpu/drm/panel/panel-samsung-s6e3hc2.c    | 88 +++++++++++++++++++-----
