+};
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3hc2-gamma.h b/drivers/gpu/drm/panel/panel-samsung-s6e3hc2-gamma.h
new file mode 100644
index 0000000000000000000000000000000000000000..bea79624a89128ddabbd55349f77679ae41856ee
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3hc2-gamma.h
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Adapted from Google coral dsi_panel_switch.c at 82a738b32e3f.
+ * Copyright (c) 2019, The Linux Foundation. All rights reserved.
+ * OTP is 60 Hz, panel flash is 90 Hz. Never substitute another panel's curves.
+ */
+static const struct {
+	u8 cmd;
+	u16 len, offset;
+	u8 prefix;
+} s6e3hc2_gamma_tables[] = {
+	{ 0xc8, 135, 0x0000, 0 },
+	{ 0xc9, 180, 0x0087, 0 },
+	{ 0xb3, 47, 0x013b, 2 },
+};
+
+static int s6e3hc2_gamma_color(u8 *buf, int band, int color)
+{
+	int index = (band % 4) * 3 + color;
+	int group = 15 * (band / 4);
+	int shift = 2 * ((index % 4) + 1);
+
+	return ((buf[group + index / 4] & (3 << (8 - shift))) << shift) |
+		buf[group + 3 + index];
+}
+
+static void s6e3hc2_gamma_set_color(u8 *buf, int band, int color, int value)
+{
+	int index = (band % 4) * 3 + color;
+	int group = 15 * (band / 4);
+	int shift = 2 * ((index % 4) + 1);
+	u8 mask = 3 << (8 - shift);
+
+	buf[group + 3 + index] = value;
+	buf[group + index / 4] &= ~mask;
+	buf[group + index / 4] |= (value >> shift) & mask;
+}
+
+static int s6e3hc2_gamma_swap(struct s6e3hc2 *ctx)
+{
+	u8 *low = ctx->gamma[0][0] + 46;
+	u8 *high = ctx->gamma[1][0] + 46;
+	int a[3], b[3], c;
+
+	if (s6e3hc2_gamma_color(high, 7, 1) - s6e3hc2_gamma_color(low, 7, 1) <
+	    s6e3hc2_gamma_color(high, 8, 1) - s6e3hc2_gamma_color(low, 8, 1))
+		return 0;
+	for (c = 0; c < 3; c++) {
+		a[c] = s6e3hc2_gamma_color(low, 7, c) +
+			s6e3hc2_gamma_color(high, 8, c) -
+			s6e3hc2_gamma_color(low, 8, c);
+		b[c] = s6e3hc2_gamma_color(low, 8, c) +
+			s6e3hc2_gamma_color(high, 7, c) -
+			s6e3hc2_gamma_color(low, 7, c);
+		if (a[c] < 0 || a[c] > 1023 || b[c] < 0 || b[c] > 1023)
+			return -ERANGE;
+	}
+	for (c = 0; c < 3; c++) {
+		s6e3hc2_gamma_set_color(high, 7, c, a[c]);
+		s6e3hc2_gamma_set_color(high, 8, c, b[c]);
+	}
+	return 0;
+}
+
+static int s6e3hc2_gamma_read(struct s6e3hc2 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context mc = { .dsi = dsi };
+	u8 revision, tmp[2];
+	int ret, cleanup, i, j;
+
+	if (ctx->gamma_ready)
+		return 0;
+	ret = mipi_dsi_dcs_read(dsi, 0xda, &revision, 1);
+	if (ret != 1 || !(revision & 0xf0))
+		return ret < 0 ? ret : -ENODEV;
+	mipi_dsi_dcs_write_seq_multi(&mc, 0xf0, 0x5a, 0x5a);
+	for (i = 0; i < ARRAY_SIZE(s6e3hc2_gamma_tables); i++) {
+		ctx->gamma[0][i][0] = s6e3hc2_gamma_tables[i].cmd;
+		ctx->gamma[1][i][0] = s6e3hc2_gamma_tables[i].cmd;
+		ret = mc.accum_err ?: mipi_dsi_dcs_read(dsi,
+			s6e3hc2_gamma_tables[i].cmd, ctx->gamma[0][i] + 1,
+			s6e3hc2_gamma_tables[i].len);
+		if (ret != s6e3hc2_gamma_tables[i].len) {
+			ret = ret < 0 ? ret : -EIO;
+			goto out;
+		}
+	}
+	/* Stock flash read sequence: enable quad read, never erase/program data. */
+	mipi_dsi_dcs_write_seq_multi(&mc, 0xf1, 0xf1, 0xa2);
+	mipi_dsi_dcs_write_seq_multi(&mc, 0xc0, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&mc, 0xc1,
+		0, 0, 0, 0x06, 0, 0, 0, 0, 0, 0, 0, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&mc, 0xc0, 0x03);
+	mipi_dsi_usleep_range(&mc, 950, 1000);
+	mipi_dsi_dcs_write_seq_multi(&mc, 0xc1,
+		0, 0, 0, 0x01, 0x40, 0x02, 0, 0, 0, 0, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&mc, 0xc0, 0x03);
+	mipi_dsi_msleep(&mc, 30);
+	for (i = 0; i < ARRAY_SIZE(s6e3hc2_gamma_tables); i++) {
+		u8 *buf = ctx->gamma[1][i] + 1;
+		u16 offset = s6e3hc2_gamma_tables[i].offset;
+
+		memcpy(buf, ctx->gamma[0][i] + 1, s6e3hc2_gamma_tables[i].prefix);
+		for (j = s6e3hc2_gamma_tables[i].prefix;
+		     j < s6e3hc2_gamma_tables[i].len; j++, offset++) {
+			u8 read[] = { 0xc1, 0, 0, 0, 0x6b, 0, 0, 0, 0x0a,
+				offset >> 8, offset & 0xff, 0, 0x05, 0x01 };
+
+			mipi_dsi_dcs_write_buffer_multi(&mc, read, sizeof(read));
+			mipi_dsi_dcs_write_seq_multi(&mc, 0xc0, 0x03);
+			mipi_dsi_usleep_range(&mc, 200, 250);
+			mipi_dsi_dcs_write_seq_multi(&mc, 0xb0, 0x0b);
+			ret = mc.accum_err ?: mipi_dsi_dcs_read(dsi, 0xfb, tmp, 2);
+			if (ret != 2) {
+				ret = ret < 0 ? ret : -EIO;
+				goto out;
+			}
+			buf[j] = tmp[1];
+		}
+		if (i < 2)
+			for (j = 0; j < s6e3hc2_gamma_tables[i].len; j += 45)
+				memset(buf + j + 39, 0, 3);
+	}
+	ret = s6e3hc2_gamma_swap(ctx);
+out:
+	/* Always close flash access and lock, including short reads/errors. */
+	cleanup = mipi_dsi_dcs_write(dsi, 0xc0, (u8[]){ 0 }, 1);
+	if (cleanup < 0 && ret >= 0)
+		ret = cleanup;
+	cleanup = mipi_dsi_dcs_write(dsi, 0xf1, (u8[]){ 0xa5, 0xa5 }, 2);
+	if (cleanup < 0 && ret >= 0)
+		ret = cleanup;
+	cleanup = mipi_dsi_dcs_write(dsi, 0xf0, (u8[]){ 0xa5, 0xa5 }, 2);
+	if (cleanup < 0 && ret >= 0)
+		ret = cleanup;
+	ctx->gamma_ready = ret == 0;
+	return ret;
+}
+
+static int s6e3hc2_gamma_write(struct s6e3hc2 *ctx)
+{
+	struct mipi_dsi_multi_context mc = { .dsi = ctx->dsi };
+	int i, mode = ctx->refresh_rate == 90;
+	u8 ctrl[] = { 0x53, mode ? 0x30 : 0x20 };
+
+	mipi_dsi_dcs_write_seq_multi(&mc, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_buffer_multi(&mc, ctrl, sizeof(ctrl));
+	if (ctx->gamma_ready)
+		for (i = 0; i < ARRAY_SIZE(s6e3hc2_gamma_tables); i++)
+			mipi_dsi_dcs_write_buffer_multi(&mc, ctx->gamma[mode][i],
+						s6e3hc2_gamma_tables[i].len + 1);
+	/* Lock even after an update failure. */
+	i = mipi_dsi_dcs_write(ctx->dsi, 0xf0, (u8[]){ 0xa5, 0xa5 }, 2);
+	return mc.accum_err ?: (i < 0 ? i : 0);
+}
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3hc2-lp.h b/drivers/gpu/drm/panel/panel-samsung-s6e3hc2-lp.h
new file mode 100644
index 0000000000000000000000000000000000000000..7c398417553b3d5075421687e4058242a35d7ee9
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3hc2-lp.h
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Commands from coral stock dtbo google,lp-modes + lp1/nolp/post-nolp. */
+static int s6e3hc2_set_lp(struct s6e3hc2 *ctx, unsigned int mode)
+{
+	struct mipi_dsi_multi_context mc = { .dsi = ctx->dsi };
+	u8 ctrl[] = { 0x53, mode == 1 ? 0x03 : 0x02 };
+	u8 level[] = { 0xbb, mode == 1 ? 0x80 : 0x00 };
+	int ret;
+
+	mipi_dsi_dcs_set_display_off_multi(&mc);
+	mipi_dsi_msleep(&mc, mode ? 17 : 0);
+	mipi_dsi_dcs_write_seq_multi(&mc, 0xf0, 0x5a, 0x5a);
+	if (mode) {
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xb0, 0x3f, 0xb5);
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xb5, 0x05);
+		mipi_dsi_dcs_write_buffer_multi(&mc, ctrl, sizeof(ctrl));
+		mipi_dsi_msleep(&mc, 36);
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xb0, 0xa8, 0xb1);
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xb1, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xb0, 0x05, 0xbb);
+		mipi_dsi_dcs_write_buffer_multi(&mc, level, sizeof(level));
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xf7, 0x02);
+	} else {
+		u8 normal[] = { 0x53, ctx->refresh_rate == 90 ? 0x30 : 0x20 };
+
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xb0, 0xa8, 0xb1);
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xb1, 0x01);
+		mipi_dsi_dcs_write_buffer_multi(&mc, normal, sizeof(normal));
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xb0, 0x3f, 0xb5);
+		mipi_dsi_dcs_write_seq_multi(&mc, 0xb5, 0x85);
+		mipi_dsi_msleep(&mc, 34);
+		ret = mc.accum_err ?: s6e3hc2_gamma_write(ctx);
+		if (ret)
+			mc.accum_err = ret;
+	}
+	ret = mipi_dsi_dcs_write(ctx->dsi, 0xf0, (u8[]){ 0xa5, 0xa5 }, 2);
+	if (!mc.accum_err && ret < 0)
+		mc.accum_err = ret;
+	mipi_dsi_msleep(&mc, mode ? 0 : 17);
+	mipi_dsi_dcs_set_display_on_multi(&mc);
+	if (!mc.accum_err)
+		ctx->lp_mode = mode;
+	return mc.accum_err;
+}
+
+static ssize_t lp_mode_show(struct device *dev, struct device_attribute *attr,
+			   char *buf)
+{
+	struct s6e3hc2 *ctx = dev_get_drvdata(dev);
+
+	guard(mutex)(&ctx->lock);
+	return sysfs_emit(buf, "%u\n", ctx->lp_mode);
+}
+
+static ssize_t lp_mode_store(struct device *dev, struct device_attribute *attr,
+			    const char *buf, size_t count)
+{
+	struct s6e3hc2 *ctx = dev_get_drvdata(dev);
+	unsigned int mode;
+	int ret = kstrtouint(buf, 10, &mode);
+
+	if (ret || mode > 2)
+		return -EINVAL;
+	guard(mutex)(&ctx->lock);
+	if (!ctx->powered)
+		return -EBUSY;
+	if (mode == ctx->lp_mode)
+		return count;
+	ret = s6e3hc2_set_lp(ctx, mode);
+	return ret ?: count;
+}
+static DEVICE_ATTR_RW(lp_mode);
+static struct attribute *s6e3hc2_attrs[] = { &dev_attr_lp_mode.attr, NULL };
+static const struct attribute_group s6e3hc2_attr_group = { .attrs = s6e3hc2_attrs };
