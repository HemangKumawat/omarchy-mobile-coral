From 5a951e9017ef Mon Sep 17 00:00:00 2001
From: Hemang Kumawat <HemangKumawat@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:25:31 +0200
Subject: [PATCH 2] arm64: dts: coral: touch coords, disable touch fw auto-update, coral firmware paths

Source commit: 5a951e9017ef (diff against 86f51f76752a).
Assisted-by: AI agents (Codex, Claude) under the author's direction
---
 arch/arm64/boot/dts/qcom/sm8150-google-coral.dts | 35 ++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-google-coral.dts b/arch/arm64/boot/dts/qcom/sm8150-google-coral.dts
index f259bf0dc92bdc78aa172b92820f4e16d7e801d8..735eca800dea7ea70843ac325b179d58ebe8da3c 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-google-coral.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-google-coral.dts
@@ -55,3 +55,38 @@ &mdss_dsi0_out {
 &mdss {
 	status = "disabled";
 };
+
+/*
+ * Touch: coral panel is 1440x3040 (flame 1080x2280).
+ * SAFETY: the downstream fts driver ignores firmware-name and always loads
+ * "ftm5_fw.ftb", reflashing the touch IC when it differs. Never auto-update:
+ * flame's blob must never reach the coral touch controller.
+ */
+&touchscreen {
+	st,max-coords = <1439 3039>;
+	st,disable-auto-fw-update;
+	firmware-name = "qcom/sm8150/google/coral/ftm5_fw_c2.ftb";
+};
+
+&gpu {
+	zap-shader {
+		firmware-name = "qcom/sm8150/google/coral/a640_zap.mdt";
+	};
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/sm8150/google/coral/adsp.mdt";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "qcom/sm8150/google/coral/cdsp.mdt";
+};
+
+&remoteproc_mpss {
+	firmware-name = "qcom/sm8150/google/coral/modem.mdt";
+};
+
+&remoteproc_slpi {
+	firmware-name = "qcom/sm8150/google/coral/slpi.mdt";
+};
+
