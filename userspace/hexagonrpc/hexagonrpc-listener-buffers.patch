diff -rN -U1 a/tests/test_listener_input.c b/tests/test_listener_input.c
--- a/tests/test_listener_input.c	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_listener_input.c	2026-10-19 05:45:46.719577352 +0000
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <assert.h>
+#include <stdarg.h>
+#include <sys/ioctl.h>
+#include <misc/fastrpc.h>
+#include "../hexagonrpcd/listener.c"
+
+static char *wire;
+static uint32_t wire_len, reported, fetches;
+static int failure, mismatch, next_failure;
+
+/* Only the kernel transport is substituted; receive and RPC encoding are real. */
+#ifdef __GLIBC__
+int ioctl(int fd, unsigned long op, ...)
+#else
+int ioctl(int fd, int op, ...)
+#endif
+{
+	va_list ap;
+	struct fastrpc_invoke *invoke;
+	struct fastrpc_invoke_args *args;
+	uint32_t cap, offset, *in, *out;
+	char *buf;
+	assert(op == FASTRPC_IOCTL_INVOKE);
+	va_start(ap, op);
+	invoke = va_arg(ap, struct fastrpc_invoke *);
+	va_end(ap);
+	assert(invoke->handle == ADSP_LISTENER);
+	if (invoke->sc == REMOTE_SCALARS_MAKE(3, 0, 0))
+		return 0;
+	args = (void *)(uintptr_t)invoke->args;
+	in = (void *)(uintptr_t)args[0].ptr;
+	if (REMOTE_SCALARS_METHOD(invoke->sc) == 4) {
+		assert(invoke->sc == REMOTE_SCALARS_MAKE(4, 2, 2));
+		assert(args[0].length == 16 && args[1].length == 0 && args[2].length == 16);
+		cap = in[3];
+		out = (void *)(uintptr_t)args[2].ptr;
+		out[0] = 73; out[1] = 1; out[2] = REMOTE_SCALARS_MAKE(5, 2, 1);
+		out[3] = reported;
+		buf = (void *)(uintptr_t)args[3].ptr;
+		assert(cap == 256 && args[3].length == cap);
+		memcpy(buf, wire, wire_len < cap ? wire_len : cap);
+		return next_failure;
+	}
+	assert(invoke->sc == REMOTE_SCALARS_MAKE(5, 1, 2));
+	assert(args[0].length == 12 && args[1].length == 4);
+	assert(in[0] == 73);
+	offset = in[1]; cap = in[2];
+	out = (void *)(uintptr_t)args[1].ptr;
+	buf = (void *)(uintptr_t)args[2].ptr;
+	assert(offset == 256 && cap == wire_len - offset && args[2].length == cap);
+	fetches++;
+	*out = reported + mismatch;
+	memcpy(buf, wire + offset, cap);
+	return failure;
+}
+
+static int receive(struct fastrpc_io_buffer **decoded)
+{
+	uint32_t ctx = 0, handle = 0, sc = 0;
+	return return_for_next_invoke(-1, 0, &ctx, &handle, &sc, NULL, decoded);
+}
+
+static void fixture(size_t size)
+{
+	uint32_t prim[] = {7, size};
+	char *payload = malloc(size ? size : 1);
+	assert(payload);
+	for (size_t i = 0; i < size; i++)
+		payload[i] = i % 251;
+	struct fastrpc_io_buffer in[] = {{sizeof(prim), prim}, {size, payload}};
+	wire_len = outbufs_calculate_size(2, in);
+	wire = malloc(wire_len);
+	assert(wire);
+	outbufs_encode(2, in, wire);
+	free(payload);
+	reported = wire_len;
+	failure = mismatch = next_failure = fetches = 0;
+}
+
+int main(void)
+{
+	const size_t sizes[] = {0, 1, 232, 233, 512, 65536, FASTRPC_MAX_INBUF_SIZE - 24};
+	struct fastrpc_io_buffer *decoded;
+	for (size_t n = 0; n < sizeof(sizes) / sizeof(*sizes); n++) {
+		fixture(sizes[n]);
+		assert(receive(&decoded) == 0);
+		assert(fetches == (wire_len > 256));
+		assert(decoded[0].s == 8 && ((uint32_t *)decoded[0].p)[0] == 7);
+		assert(decoded[1].s == sizes[n]);
+		for (size_t i = 0; i < sizes[n]; i++)
+			assert(((unsigned char *)decoded[1].p)[i] == i % 251);
+		iobuf_free(2, decoded);
+		free(wire);
+	}
+	fixture(512);
+	reported = FASTRPC_MAX_INBUF_SIZE + 1;
+	assert(receive(&decoded) == -E2BIG && !fetches);
+	reported = wire_len;
+	mismatch = 1;
+	assert(receive(&decoded) == -EPROTO);
+	mismatch = -1;
+	assert(receive(&decoded) == -EPROTO);
+	mismatch = 0;
+	failure = -EIO;
+	assert(receive(&decoded) == -EIO);
+	failure = 0;
+	/* A malicious inner length cannot bypass the aggregate allocation ceiling. */
+	memset(wire, 0xff, 4);
+	assert(receive(&decoded) != 0 && errno == E2BIG);
+	free(wire);
+	fixture(1);
+	reported = 1;
+	assert(receive(&decoded) != 0);
+	next_failure = -EIO;
+	assert(run_fastrpc_listener(-1, 0, NULL) == -EIO);
+	free(wire);
+	puts("listener small/large/limit/decode/transport guards passed");
+	return 0;
+}
