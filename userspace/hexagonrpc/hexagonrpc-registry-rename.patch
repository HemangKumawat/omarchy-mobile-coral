+
+int hexagonfs_rename(struct hexagonfs_fd **fds, int rootfd, const char *oldname, const char *newname)
+{
+	struct hexagonfs_fd *source, *dest = NULL;
+	const char *oldbase = strrchr(oldname, '/'), *newbase = strrchr(newname, '/');
+	char *parent;
+	int ret;
+	oldbase = oldbase ? oldbase + 1 : oldname;
+	newbase = newbase ? newbase + 1 : newname;
+	if (!*oldbase || !*newbase || !strcmp(oldbase, ".") || !strcmp(oldbase, "..")
+	 || !strcmp(newbase, ".") || !strcmp(newbase, ".."))
+		return -EINVAL;
+	ret = resolve_path(fds[rootfd], fds[rootfd], oldname, O_NONBLOCK, &source);
+	if (ret)
+		return ret;
+	ret = -EROFS;
+	if (!source->ops->rename)
+		goto out;
+	parent = newbase == newname ? strdup(".") : strndup(newname, newbase - newname);
+	if (!parent) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ret = resolve_path(fds[rootfd], fds[rootfd], parent, O_RDONLY, &dest);
+	free(parent);
+	if (!ret)
+		ret = source->ops->rename(source, oldbase, dest, newbase);
+out:
+	destroy_file_descriptor(dest);
+	destroy_file_descriptor(source);
+	return ret;
 }
