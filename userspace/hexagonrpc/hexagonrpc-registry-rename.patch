diff -rN -U1 a/hexagonrpcd/hexagonfs_mapped.c b/hexagonrpcd/hexagonfs_mapped.c
--- a/hexagonrpcd/hexagonfs_mapped.c	2026-10-19 05:40:24.471603371 +0000
+++ b/hexagonrpcd/hexagonfs_mapped.c	2026-10-19 05:49:37.615327906 +0000
@@ -381,2 +381,34 @@
 
+static int registry_rename(struct hexagonfs_fd *source, const char *oldname,
+			    struct hexagonfs_fd *dest, const char *newname)
+{
+	struct mapped_ctx *src = source->data, *from, *to;
+	struct stat st;
+	int target, ret;
+	struct open_how how = {
+		.flags = O_NONBLOCK | O_NOFOLLOW,
+		.resolve = RESOLVE_BENEATH | RESOLVE_NO_SYMLINKS | RESOLVE_NO_XDEV,
+	};
+	if (!source->up || source->up->ops != &hexagonfs_registry_ops
+	 || dest->ops != &hexagonfs_registry_ops)
+		return -EROFS;
+	if (fstat(src->fd, &st))
+		return -errno;
+	if (!S_ISREG(st.st_mode))
+		return -EINVAL;
+	from = source->up->data;
+	to = dest->data;
+	target = syscall(SYS_openat2, to->fd, newname, &how, sizeof(how));
+	if (target < 0 && errno != ENOENT)
+		return -errno;
+	if (target >= 0) {
+		ret = fstat(target, &st) ? -errno : (!S_ISREG(st.st_mode) ? -EINVAL : 0);
+		close(target);
+		if (ret)
+			return ret;
+	}
+	/* Both parents are held on tmpfs; renameat2 replaces a regular target atomically. */
+	return syscall(SYS_renameat2, from->fd, oldname, to->fd, newname, 0) < 0 ? -errno : 0;
+}
+
 struct hexagonfs_file_ops hexagonfs_registry_ops = {
@@ -388,2 +420,3 @@
 	.remove = registry_remove,
+	.rename = registry_rename,
 	.readdir = mapped_readdir,
