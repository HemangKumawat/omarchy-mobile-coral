diff -rN -U1 a/tests/test_registry_rename.c b/tests/test_registry_rename.c
--- a/tests/test_registry_rename.c	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_registry_rename.c	2026-10-19 05:51:23.089516195 +0000
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <assert.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <misc/fastrpc.h>
+#include "../hexagonrpcd/listener.c"
+#include "../hexagonrpcd/apps_std.h"
+#include "../hexagonrpcd/rpcd_builder.h"
+
+static struct fastrpc_interface *interfaces[2];
+static char *root;
+static const char *src = "/mnt/vendor/persist/sensors/registry/temp.json";
+static const char *dst = "/persist/sensors/registry/registry/item";
+
+#ifdef __GLIBC__
+int ioctl(int fd, unsigned long op, ...)
+#else
+int ioctl(int fd, int op, ...)
+#endif
+{
+	va_list ap;
+	va_start(ap, op);
+	struct fastrpc_invoke *call = va_arg(ap, struct fastrpc_invoke *);
+	va_end(ap);
+	assert(op == FASTRPC_IOCTL_INVOKE && call->sc == 0x1f030000 && call->handle == 1);
+	struct fastrpc_invoke_args *args = (void *)(uintptr_t)call->args;
+	uint32_t *prim = (void *)(uintptr_t)args[0].ptr, result;
+	assert(args[0].length == 12 && prim[0] == 33);
+	assert(prim[1] == args[1].length && prim[2] == args[2].length);
+	struct fastrpc_io_buffer in[3], *out = NULL;
+	for (size_t i = 0; i < 3; i++)
+		in[i] = (struct fastrpc_io_buffer){args[i].length, (void *)(uintptr_t)args[i].ptr};
+	assert(invoke_requested_procedure(2, interfaces, 1, call->sc, &result, in, &out) == 0);
+	iobuf_free(0, out);
+	return result;
+}
+
+static int rpc_rename(const char *oldname, const char *newname)
+{
+	return hexagonrpc(interfaces[1]->procs[33].def, -1, 1,
+		(uint32_t)strlen(oldname) + 1, oldname, (uint32_t)strlen(newname) + 1, newname);
+}
+
+static void write_file(const char *name, const char *text)
+{
+	char path[256];
+	snprintf(path, sizeof(path), "%s/sensors/%s", root, name);
+	int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+	assert(fd >= 0 && write(fd, text, strlen(text)) == (ssize_t)strlen(text));
+	assert(close(fd) == 0);
+}
+
+static void check_file(const char *name, const char *text)
+{
+	char path[256], buf[32] = {0};
+	snprintf(path, sizeof(path), "%s/sensors/%s", root, name);
+	int fd = open(path, O_RDONLY);
+	assert(fd >= 0 && read(fd, buf, sizeof(buf)) == (ssize_t)strlen(text));
+	assert(!memcmp(buf, text, strlen(text)) && close(fd) == 0);
+}
+
+int main(int argc, char **argv)
+{
+	char tmp[] = "/dev/shm/coral-rename-XXXXXX", path[256];
+	root = mkdtemp(tmp);
+	assert(root);
+	const char *dirs[] = {"sensors", "sensors/registry", "sensors/config"};
+	for (size_t i = 0; i < 3; i++) {
+		snprintf(path, sizeof(path), "%s/%s", root, dirs[i]);
+		assert(mkdir(path, 0700) == 0);
+	}
+	write_file("temp.json", "new"); write_file("registry/item", "old");
+	write_file("config/readonly", "stock");
+	interfaces[1] = fastrpc_apps_std_init(construct_root_dir(root, "sdsp"));
+	assert(interfaces[1] && interfaces[1]->n_procs == 34);
+	snprintf(path, sizeof(path), "%s/sensors/registry/item", root);
+	int oldfd = open(path, O_RDONLY);
+	assert(oldfd >= 0 && rpc_rename(src, dst) == 0);
+	char old[3];
+	assert(read(oldfd, old, sizeof(old)) == 3 && !memcmp(old, "old", 3));
+	assert(close(oldfd) == 0);
+	check_file("registry/item", "new");
+	snprintf(path, sizeof(path), "%s/sensors/temp.json", root);
+	assert(access(path, F_OK) == -1 && errno == ENOENT);
+	assert(rpc_rename(dst, dst) == 0);
+	write_file("temp.json", "next");
+	assert(rpc_rename(src, "/persist/sensors/registry/registry/second") == 0);
+	check_file("registry/second", "next");
+	write_file("temp.json", "keep");
+	snprintf(path, sizeof(path), "%s/sensors/link", root);
+	assert(symlink("config/readonly", path) == 0);
+	snprintf(path, sizeof(path), "%s/sensors/escape", root);
+	assert(symlink("config", path) == 0);
+	const char *ro = "/vendor/etc/sensors/config/readonly";
+	const char *escape = "/persist/sensors/registry/../../../../vendor/etc/sensors/config/readonly";
+	const char *link = "/persist/sensors/registry/link";
+	const char *via = "/persist/sensors/registry/escape/readonly";
+	const char *bad[][2] = {
+		{ro,dst}, {src,ro}, {escape,dst}, {src,escape}, {link,dst}, {src,link},
+		{via,dst}, {src,via}, {"/persist/sensors/registry",dst},
+		{"/persist/sensors/registry/registry",dst}, {src,"/persist/sensors/registry"},
+		{src,"/persist/sensors/registry/registry"}, {src,"/"}, {src,"."},
+		{src,"../outside"}, {"/persist/sensors/registry/missing",dst},
+	};
+	for (size_t i = 0; i < sizeof(bad) / sizeof(*bad); i++)
+		assert(rpc_rename(bad[i][0], bad[i][1]) == AEE_EFAILED);
+	check_file("temp.json", "keep"); check_file("registry/item", "new");
+	check_file("config/readonly", "stock");
+	struct fastrpc_io_buffer invalid[3] = {{0,NULL},{1,"x"},{0,NULL}};
+	assert(interfaces[1]->procs[33].impl(interfaces[1]->data, invalid, NULL) == AEE_EBADPARM);
+	assert(rpc_rename(src, dst) == 0);
+	check_file("registry/item", "keep");
+	fastrpc_apps_std_deinit(interfaces[1]);
+	const char *files[] = {"registry/item", "registry/second", "config/readonly", "link", "escape"};
+	for (size_t i = 0; i < 5; i++) {
+		snprintf(path, sizeof(path), "%s/sensors/%s", root, files[i]);
+		assert(unlink(path) == 0);
+	}
+	for (int i = 2; i >= 0; i--) {
+		snprintf(path, sizeof(path), "%s/%s", root, dirs[i]);
+		assert(rmdir(path) == 0);
+	}
+	assert(rmdir(root) == 0);
+	if (argc == 2) {
+		root = argv[1];
+		write_file("temp.json", "disk");
+		interfaces[1] = fastrpc_apps_std_init(construct_root_dir(root, "sdsp"));
+		assert(interfaces[1] && rpc_rename(src, dst) == AEE_EFAILED);
+		check_file("temp.json", "disk");
+		fastrpc_apps_std_deinit(interfaces[1]);
+		snprintf(path, sizeof(path), "%s/sensors/temp.json", root);
+		assert(unlink(path) == 0);
+	}
+	puts("extended rename RPC, atomic replacement and RAM/RO/traversal/symlink/directory guards passed");
+	return 0;
+}
