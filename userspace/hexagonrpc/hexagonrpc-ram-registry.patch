diff -rN -U0 a/tests/test_registry.c b/tests/test_registry.c
--- a/tests/test_registry.c	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_registry.c	2026-10-19 05:40:24.471603371 +0000
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "../hexagonrpcd/hexagonfs.h"
+#include "../hexagonrpcd/apps_std.h"
+#include "../hexagonrpcd/rpcd_builder.h"
+#include <libhexagonrpc/error.h>
+
+static uint32_t rpc_remove(struct fastrpc_interface *iface, const char *name)
+{
+	uint32_t len = strlen(name) + 1;
+	struct fastrpc_io_buffer in[] = {{sizeof(len), &len}, {len, (void *)name}};
+	return iface->procs[24].impl(iface->data, in, NULL);
+}
+
+int main(int argc, char **argv)
+{
+	char root[] = "/dev/shm/coral-hexagonfs-XXXXXX";
+	char path[256], buf[8] = {0};
+	struct hexagonfs_fd *fds[HEXAGONFS_MAX_FD] = {0};
+	int fd, rootfd;
+	assert(mkdtemp(root));
+	snprintf(path, sizeof(path), "%s/sensors", root);
+	assert(mkdir(path, 0700) == 0);
+	snprintf(path, sizeof(path), "%s/sensors/registry", root);
+	assert(mkdir(path, 0700) == 0);
+	snprintf(path, sizeof(path), "%s/sensors/config", root);
+	assert(mkdir(path, 0700) == 0);
+	snprintf(path, sizeof(path), "%s/sensors/config/readonly", root);
+	fd = open(path, O_WRONLY | O_CREAT, 0600);
+	assert(fd >= 0);
+	assert(write(fd, "stock", 5) == 5);
+	close(fd);
+	rootfd = hexagonfs_open_root(fds, construct_root_dir(root, "sdsp"));
+	assert(rootfd >= 0);
+	const char *temp = "/mnt/vendor/persist/sensors/registry/temp.json";
+	fd = hexagonfs_openat_flags(fds, rootfd, rootfd, temp, O_WRONLY | O_CREAT | O_TRUNC);
+	assert(fd >= 0);
+	assert(hexagonfs_write(fds, fd, 4, "test") == 4);
+	assert(hexagonfs_close(fds, fd) == 0);
+	fd = hexagonfs_openat_flags(fds, rootfd, rootfd, temp, O_WRONLY | O_TRUNC);
+	assert(fd >= 0);
+	assert(hexagonfs_write(fds, fd, 1, "a") == 1);
+	assert(hexagonfs_close(fds, fd) == 0);
+	fd = hexagonfs_openat_flags(fds, rootfd, rootfd, temp, O_WRONLY | O_APPEND);
+	assert(fd >= 0);
+	assert(hexagonfs_write(fds, fd, 1, "b") == 1);
+	assert(hexagonfs_close(fds, fd) == 0);
+	fd = hexagonfs_openat(fds, rootfd, rootfd, "/persist/sensors/registry/temp.json");
+	assert(fd >= 0);
+	assert(hexagonfs_read(fds, fd, sizeof(buf), buf) == 2);
+	assert(strcmp(buf, "ab") == 0);
+	assert(hexagonfs_close(fds, fd) == 0);
+	fd = hexagonfs_openat_flags(fds, rootfd, rootfd,
+		"/persist/sensors/registry/sns_reg_version", O_WRONLY | O_CREAT);
+	assert(fd >= 0);
+	assert(hexagonfs_write(fds, fd, 1, "1") == 1);
+	assert(hexagonfs_close(fds, fd) == 0);
+	assert(hexagonfs_openat_flags(fds, rootfd, rootfd,
+		"/vendor/etc/sensors/config/readonly", O_WRONLY | O_TRUNC) == -EROFS);
+	fd = hexagonfs_openat(fds, rootfd, rootfd, "/vendor/etc/sensors/config/readonly");
+	assert(fd >= 0);
+	assert(hexagonfs_write(fds, fd, 1, "!") == -EROFS);
+	assert(hexagonfs_close(fds, fd) == 0);
+	snprintf(path, sizeof(path), "%s/sensors/escape", root);
+	assert(symlink("/tmp", path) == 0);
+	assert(hexagonfs_openat_flags(fds, rootfd, rootfd,
+		"/persist/sensors/registry/escape/no-write", O_WRONLY | O_CREAT) < 0);
+	assert(unlink(path) == 0);
+	/* Exercise actual apps_std fopen/fwrite/fclose implementations and metadata. */
+	struct fastrpc_interface *iface = fastrpc_apps_std_init(construct_root_dir(root, "sdsp"));
+	assert(iface && iface->procs[5].def->msg_id == 5);
+	uint32_t handle, prim[2] = {0}, result[2] = {0};
+	const char env[] = "ADSP_LIBRARY_PATH", mode[] = "w", empty[] = "";
+	struct fastrpc_io_buffer in[] = {
+		{sizeof(prim), prim}, {sizeof(env), (void *)env},
+		{sizeof(empty), (void *)empty}, {strlen(temp) + 1, (void *)temp},
+		{sizeof(mode), (void *)mode},
+	};
+	struct fastrpc_io_buffer out = {sizeof(handle), &handle};
+	assert(iface->procs[19].impl(iface->data, in, &out) == 0);
+	prim[0] = handle; prim[1] = 3;
+	struct fastrpc_io_buffer write_in[] = {{sizeof(prim), prim}, {3, "rpc"}};
+	out.s = sizeof(result); out.p = result;
+	assert(iface->procs[5].impl(iface->data, write_in, &out) == 0);
+	assert(result[0] == 3 && result[1] == 0);
+	assert(iface->procs[3].impl(iface->data, write_in, NULL) == 0);
+	fd = hexagonfs_openat(fds, rootfd, rootfd, temp);
+	assert(fd >= 0);
+	memset(buf, 0, sizeof(buf));
+	assert(hexagonfs_read(fds, fd, sizeof(buf), buf) == 3);
+	assert(strcmp(buf, "rpc") == 0);
+	assert(hexagonfs_close(fds, fd) == 0);
+	assert(iface->procs[24].def->msg_id == 24);
+	assert(iface->procs[24].def->n_args == 1);
+	assert(iface->procs[24].def->args[0].t == HRPC_ARG_BLOB_SEQ);
+	assert(rpc_remove(iface, temp) == 0);
+	assert(hexagonfs_openat(fds, rootfd, rootfd, temp) == -ENOENT);
+	assert(rpc_remove(iface, temp) == AEE_EFAILED);
+	assert(rpc_remove(iface, "/persist/sensors/registry/registry/../sns_reg_version") == 0);
+	assert(rpc_remove(iface, "/vendor/etc/sensors/config/readonly") == AEE_EFAILED);
+	assert(rpc_remove(iface,
+		"/persist/sensors/registry/../../../../vendor/etc/sensors/config/readonly") == AEE_EFAILED);
+	assert(rpc_remove(iface, "/persist/sensors/registry/..") == AEE_EFAILED);
+	assert(rpc_remove(iface, "/persist/sensors/registry") == AEE_EFAILED);
+	assert(rpc_remove(iface, "/persist/sensors/registry/registry") == AEE_EFAILED);
+	snprintf(path, sizeof(path), "%s/sensors/link", root);
+	assert(symlink("config/readonly", path) == 0);
+	assert(rpc_remove(iface, "/persist/sensors/registry/link") == AEE_EFAILED);
+	assert(unlink(path) == 0);
+	snprintf(path, sizeof(path), "%s/sensors/escape", root);
+	assert(symlink("config", path) == 0);
+	assert(rpc_remove(iface, "/persist/sensors/registry/escape/readonly") == AEE_EFAILED);
+	assert(unlink(path) == 0);
+	struct fastrpc_io_buffer bad[] = {{0, NULL}, {1, "x"}};
+	assert(iface->procs[24].impl(iface->data, bad, NULL) == AEE_EBADPARM);
+	bad[1].s = 0;
+	assert(iface->procs[24].impl(iface->data, bad, NULL) == AEE_EBADPARM);
+	fd = hexagonfs_openat(fds, rootfd, rootfd, "/vendor/etc/sensors/config/readonly");
+	assert(fd >= 0);
+	assert(hexagonfs_read(fds, fd, sizeof(buf), buf) == 5);
+	assert(memcmp(buf, "stock", 5) == 0);
+	assert(hexagonfs_close(fds, fd) == 0);
+	fastrpc_apps_std_deinit(iface);
+	assert(hexagonfs_close(fds, rootfd) == 0);
+	snprintf(path, sizeof(path), "%s/sensors/config/readonly", root);
+	assert(unlink(path) == 0);
+	snprintf(path, sizeof(path), "%s/sensors/config", root);
+	assert(rmdir(path) == 0);
+	snprintf(path, sizeof(path), "%s/sensors/registry", root);
+	assert(rmdir(path) == 0);
+	snprintf(path, sizeof(path), "%s/sensors", root);
+	assert(rmdir(path) == 0);
+	assert(rmdir(root) == 0);
+	if (argc == 2) {
+		snprintf(path, sizeof(path), "%s/sensors/temp.json", argv[1]);
+		fd = open(path, O_WRONLY | O_CREAT | O_EXCL, 0600);
+		assert(fd >= 0);
+		assert(write(fd, "disk", 4) == 4);
+		assert(close(fd) == 0);
+		rootfd = hexagonfs_open_root(fds, construct_root_dir(argv[1], "sdsp"));
+		assert(rootfd >= 0);
+		assert(hexagonfs_openat_flags(fds, rootfd, rootfd, temp,
+			O_WRONLY | O_CREAT) == -EROFS);
+		assert(hexagonfs_close(fds, rootfd) == 0);
+		iface = fastrpc_apps_std_init(construct_root_dir(argv[1], "sdsp"));
+		assert(iface);
+		assert(rpc_remove(iface, temp) == AEE_EFAILED);
+		fastrpc_apps_std_deinit(iface);
+		fd = open(path, O_RDONLY);
+		assert(fd >= 0 && read(fd, buf, sizeof(buf)) == 4);
+		assert(memcmp(buf, "disk", 4) == 0);
+		assert(close(fd) == 0 && unlink(path) == 0);
+	}
+	puts("registry write/remove RPC and RO/traversal/symlink/non-RAM guards passed");
+	return 0;
+}
