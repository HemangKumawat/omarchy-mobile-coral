+			ret = fd->ops->openat(fd, segment, expect_dir, *curr ? O_RDONLY : flags, &fd);
@@ -190,0 +192,30 @@
+	return ret;
+}
+
+int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+{
+	return hexagonfs_openat_flags(fds, rootfd, dirfd, name, O_RDONLY);
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD || !fds[fileno])
+		return -EBADF;
+	if (!fds[fileno]->ops->write)
+		return -EROFS;
+	return fds[fileno]->ops->write(fds[fileno], size, ptr);
+}
+
+int hexagonfs_remove(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+{
+	const char *base = strrchr(name, '/');
+	int fd, ret;
+	base = base ? base + 1 : name;
+	if (!*base || !strcmp(base, ".") || !strcmp(base, ".."))
+		return -EINVAL;
+	/* Resolve the final file with the same tmpfs/no-symlink/no-mount guards. */
+	fd = hexagonfs_openat(fds, rootfd, dirfd, name);
+	if (fd < 0)
+		return fd;
+	ret = fds[fd]->ops->remove ? fds[fd]->ops->remove(fds[fd], base) : -EROFS;
+	hexagonfs_close(fds, fd);
