+static int registry_from_dirent(const void *path, bool dir, void **fd_data)
+{
+	struct mapped_ctx *ctx;
+	struct statfs fs;
+	int fd = open(path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW);
+	if (fd < 0)
+		return -errno;
+	if (fstatfs(fd, &fs) || fs.f_type != TMPFS_MAGIC) {
+		close(fd);
+		return -EROFS;
+	}
+	ctx = calloc(1, sizeof(*ctx));
+	if (!ctx) {
+		close(fd);
+		return -ENOMEM;
+	}
+	ctx->fd = fd;
+	ctx->writable = true;
+	*fd_data = ctx;
+	return 0;
+}
+
+static ssize_t registry_write(struct hexagonfs_fd *fd, size_t size, const void *ptr)
+{
+	struct mapped_ctx *ctx = fd->data;
+	ssize_t ret = write(ctx->fd, ptr, size);
+	return ret < 0 ? -errno : ret;
+}
+
+static int registry_remove(struct hexagonfs_fd *fd, const char *name)
+{
+	struct mapped_ctx *parent;
+	if (!fd->up || fd->up->ops != &hexagonfs_registry_ops)
+		return -EROFS;
+	parent = fd->up->data;
+	/* unlinkat never follows a replaced final symlink; the parent is held open. */
+	return unlinkat(parent->fd, name, 0) < 0 ? -errno : 0;
+}
+
+struct hexagonfs_file_ops hexagonfs_registry_ops = {
+	.close = mapped_close,
+	.from_dirent = registry_from_dirent,
+	.openat = mapped_openat,
+	.read = mapped_read,
+	.write = registry_write,
+	.remove = registry_remove,
+	.readdir = mapped_readdir,
+	.seek = mapped_seek,
+	.stat = mapped_stat,
+};
