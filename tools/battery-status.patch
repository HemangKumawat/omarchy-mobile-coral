+// Coral consumes only the root Rust policy's measured status, never UPower capacity.
+function coralBattery(raw, now) {
+  var unavailable = { charging: false, voltage: "voltage unavailable",
+    reason: "not charging: battery status unavailable", valid: false }
+  unavailable.text = unavailable.reason + " · " + unavailable.voltage
+  var state
+  try { state = JSON.parse(raw) } catch (error) { return unavailable }
+  if (!state || typeof state.updated_unix_seconds !== "number"
+      || !isFinite(state.updated_unix_seconds) || state.updated_unix_seconds > now + 5
+      || now - state.updated_unix_seconds > 30) return unavailable
+  var battery = state.battery
+  if (!battery || typeof battery.charging !== "boolean"
+      || typeof battery.temperature_known !== "boolean") return unavailable
+  var uv = battery.voltage_now_uv
+  var validVoltage = typeof uv === "number" && isFinite(uv) && uv >= 2500000 && uv <= 5000000
+  var voltage = validVoltage ? (uv / 1000000).toFixed(2) + " V" : "voltage unavailable"
+  var charging = battery.temperature_known && battery.charging
+  var reason = !battery.temperature_known ? "not charging: battery temperature unknown"
+    : charging ? "charging: yes"
+    : typeof battery.charge_reason === "string" && battery.charge_reason.indexOf("not charging:") === 0
+      ? battery.charge_reason : "charging: no"
+  return { charging: charging, voltage: voltage, reason: reason,
+    text: reason + " · " + voltage, valid: true }
+}
